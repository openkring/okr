{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest"],
    "declaration": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "disableTypeScriptVersionCheck": true,
    "compileNonExportedClasses": true
  },
  "include": ["src/**/*", "**/*.spec.ts", "**/*.test.ts"],
  "exclude": ["dist/**/*"],
  "references": [
    {"path": "../util/tsconfig.lib.json"},
    {"path": "../data-access/tsconfig.lib.json"},
    {"path": "../../auth/feature/tsconfig.lib.json"},
    {"path": "../../aoc/feature/tsconfig.lib.json"},
    {"path": "../../calevent/feature/tsconfig.lib.json"},
    {"path": "../../shared/feature/tsconfig.lib.json"},
    {"path": "../../shared/models/tsconfig.lib.json"}
  ]
}
