{
  "name": "social-news-center-feature",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/social/news-center/feature/src",
  "prefix": "okr",
  "projectType": "library",
  "tags": ["type:feature", "scope:social", "platform:mobile", "platform:web"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/social/news-center/feature",
        "main": "libs/social/news-center/feature/src/index.ts",
        "tsConfig": "libs/social/news-center/feature/tsconfig.lib.json",
        "assets": ["libs/social/news-center/feature/*.md"],
        "updateBuildableProjectDepsInPackageJson": false
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "libs/social/news-center/feature/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
