{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "../../../dist/libs/shared/util-angular",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "../../../dist/out-tsc/shared-util-angular.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.spec2.ts", "**/test-setup.ts", "vite.config.ts"],
  "references": [
    { "path": "../config/tsconfig.lib.json" },
    { "path": "../constants/tsconfig.lib.json" },
    { "path": "../i18n/tsconfig.lib.json" },
    { "path": "../models/tsconfig.lib.json" },
    { "path": "../util-core/tsconfig.lib.json" }
  ]
}
