{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest"],
    "declaration": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"],
    "ignoreDeprecations": "6.0",
    "rootDir": "../../.."
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "disableTypeScriptVersionCheck": true,
    "compileNonExportedClasses": true
  },
  "include": ["src/**/*", "**/*.spec.ts", "**/*.test.ts", "../data-access/src/lib/app-config.service.ts"],
  "exclude": ["dist/**/*"],
  "references": [
    {
      "path": "../models/tsconfig.lib.json"
    },
    {
      "path": "../config/tsconfig.lib.json"
    },
    {
      "path": "../constants/tsconfig.lib.json"
    },
    {
      "path": "../data-access/tsconfig.lib.json"
    },
    {
      "path": "../util-core/tsconfig.lib.json"
    },
    {
      "path": "../util-angular/tsconfig.lib.json"
    },
    {
      "path": "../../session/data-access/tsconfig.lib.json"
    },
    {
      "path": "../i18n/tsconfig.lib.json"
    },
    {
      "path": "../pipes/tsconfig.lib.json"
    },
    {
      "path": "../ui/tsconfig.lib.json"
    },
    {
      "path": "../../avatar/ui/tsconfig.lib.json"
    },
    {
      "path": "../../relationship/responsibility/data-access/tsconfig.lib.json"
    }
  ]
}
