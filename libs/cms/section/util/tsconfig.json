{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest"],
    "declaration": true,
    "ignoreDeprecations": "6.0",
    // libs, not src: mail-blocks.vectors.spec.ts reads the shared test table in shared/util-core/src/testing (no lib export, not built)
    "rootDir": "../../.."
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "disableTypeScriptVersionCheck": true,
    "compileNonExportedClasses": true
  },
  "include": ["src/**/*", "**/*.spec.ts", "**/*.test.ts"],
  "exclude": ["dist/**/*"],
  "references": [
    { "path": "../../../shared/models/tsconfig.lib.json" },
    { "path": "../../../shared/constants/tsconfig.lib.json" },
    { "path": "../../../shared/categories/tsconfig.lib.json" },
    { "path": "../../../shared/i18n/tsconfig.lib.json" },
    { "path": "../../../shared/util-core/tsconfig.lib.json" },
    { "path": "../../menu/util/tsconfig.lib.json" },
    { "path": "../../../content/document/util/tsconfig.lib.json" },
    { "path": "../../../forms/util/tsconfig.lib.json" }
  ]
}
