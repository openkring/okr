{
  "name": "mobility-transit-util",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mobility/transit/util/src",
  "prefix": "okr",
  "projectType": "library",
  "tags": [
    "type:util",
    "scope:mobility",
    "platform:mobile",
    "platform:web"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/mobility/transit/util",
        "main": "libs/mobility/transit/util/src/index.ts",
        "tsConfig": "libs/mobility/transit/util/tsconfig.lib.json",
        "assets": [],
        "updateBuildableProjectDepsInPackageJson": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "configFile": "libs/mobility/transit/util/vite.config.ts"
      }
    }
  }
}
