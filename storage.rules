rules_version = '2';

// Authorization mirrors firestore.rules: derived from the caller's
// users/{uid} document (roles map + tenants array), NOT from custom claims
// (which are never minted in this project). Storage rules can read Firestore
// via firestore.get()/firestore.exists().
//
// Tenant is encoded in the object path. Data lives under three prefixes:
//   tenant/{tenantId}/...           (dominant: avatars, documents, addresses, qr-bills, rag)
//   tenants/{tenantId}/...          (esign — plural prefix)
//   {tenantId}/{modelType}/{key}/documents/...  (bare-tenant document path)
// Tenant-agnostic prefixes: forms/{formKey}/... and logo/... (global assets).
//
// Display images are served by imgix (GCS/IAM access, which bypasses these
// rules), so no public read is required here — only the app's direct
// getDownloadURL / listAll calls are governed by these rules.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function userExists() {
      return signedIn() && firestore.exists(userPath());
    }
    function userData() {
      return firestore.get(userPath()).data;
    }
    // The given tenant id is one of the caller's tenants.
    function inTenant(tenantId) {
      return userExists() && (tenantId in userData().tenants);
    }
    function hasRole(role) {
      return userExists() && userData().roles.get(role, false) == true;
    }
    function isPrivileged() {
      return hasRole('admin') || hasRole('privileged');
    }
    // CF-only sub-prefix under tenant/{tenantId}/ — currently `private/exports/` (D-P5-1
    // subject-access export ZIPs: AHV number, dob, IBAN in plaintext). NOTE: Storage
    // Security Rules OR every matching `match` block's `allow` condition together, so a
    // sibling `allow read, write: if false` block for this sub-path could NOT by itself
    // override the broader `tenant/{tenantId}/{path=**}` grant below — both blocks match
    // the same object, and the broader one would still independently grant `read`. The
    // guard therefore has to live INSIDE that broader rule's own condition (see below).
    //
    // It is carved out by MATCH SHAPE, not by inspecting `resource.name`: a `list`
    // request carries no `resource` at all, so any condition that touches `resource`
    // (even `resource == null`) raises "Null value error", the whole condition
    // evaluates to an error, and the rule denies. That is what broke `listAll()` on
    // the entire `tenant/` prefix. Binding the first sub-segment as `{sub}` lets us
    // exclude `private/` without reading any object metadata.
    //
    // Upload size cap (only valid when request.resource is present, i.e. create/update).
    //
    // There are two caps, and the reason is that they answer two different questions.
    // `sizeOk()` is the general one: 25 MB is more than any document, scan or phone photo
    // this app has ever seen, and holding it there is what keeps a stray or hostile upload
    // from filling the bucket. Album VIDEOS genuinely need more — a 2-minute 1080p clip off
    // an iPhone is routinely 60-150 MB — so they get their own, deliberately narrow grant
    // below (`videoSizeOk()`, 200 MB) instead of the general cap being raised for everything.
    // Raising `sizeOk()` would buy the videos their headroom at the price of letting a
    // 200 MB anything land anywhere in the bucket; the carve-out costs one match block.
    //
    // 200 MB is not a free choice: it must stay equal to MAX_VIDEO_BYTES in
    // libs/shared/util-core/src/lib/video.util.ts (the client-side pre-check) and to
    // MAX_INPUT_BYTES in apps/functions/src/video/index.ts (the transcoder's backstop).
    // The three are one limit expressed in three places; if they drift, the user either
    // uploads what nothing will process or is refused what the client already accepted --
    // and Firebase refuses with a bare `storage/unauthorized`, i.e. a red cross and no text.
    function sizeOk() {
      return request.resource.size < 25 * 1024 * 1024;   // 25 MB cap
    }
    function videoSizeOk() {
      return request.resource.size < 200 * 1024 * 1024;  // 200 MB cap, album videos only
    }
    // Video by file EXTENSION, never by contentType. `uploadToFirebaseStorage` passes no
    // explicit contentType, so the browser-inferred `File.type` wins -- and for .mov that is
    // regularly empty in Chrome/Firefox, which is exactly how the 147 live objects carrying
    // `application/x-www-form-urlencoded` (see contentTypeOk below) came about. Gating the
    // raised cap on contentType would therefore refuse precisely the iPhone clips it exists
    // for. The extension set mirrors DEFAULT_ACCEPT_ATTRIBUTE (@okr/shared-constants), which
    // is what the file dialog actually offers. Safe on `request.resource` because this is
    // only ever called from a create/update condition -- never from a read or list, where
    // touching `resource` raises "Null value error" (see the note above).
    function isVideoUpload() {
      return request.resource.name.lower().matches('.*[.](mp4|m4v|mov)');
    }
    // Content type (H-1 / M-9, Phase 2). This is a DENYLIST of active HTML content,
    // not the allowlist the security report originally proposed. The MIME set was
    // confirmed 2026-08-16 against all 3'700 live objects in the bucket:
    //   image/{jpeg,png,tiff,svg+xml,webp,heic}, application/pdf, MS Office + iWork,
    //   video/{quicktime,mp4}, audio/mpegurl, application/octet-stream, and 147 objects
    //   carrying `application/x-www-form-urlencoded;charset=UTF-8` — Firebase's default
    //   when the SDK uploads without an explicit contentType (uploadToFirebaseStorage
    //   passes none, so the browser-inferred File.type wins, and it is often empty).
    // An allowlist would therefore have to admit both that default AND image/svg+xml
    // (819 objects: tenant logos and icons) — i.e. admit the two riskiest values anyway
    // while still breaking any file type not yet seen. Denying the handful of types that
    // actually execute as a document buys the same protection at zero false-positive
    // risk: not one live object is text/html or *xml.
    // SVG stays allowed by necessity; it is mitigated by never being served from an app
    // origin (imgix, or firebasestorage.googleapis.com download URLs).
    // Not covered by the emulator harness — the Storage emulator does not populate
    // request.resource.contentType for rule evaluation.
    function contentTypeOk() {
      return request.resource.contentType == null
        || !request.resource.contentType.lower().matches('(text/html|application/xhtml[+]xml|(text|application)/xml)([;].*)?');
    }

    // ---- tenant-scoped data (dominant prefix) ----
    // `sub != 'private'` carves the CF-only `private/` sub-prefix (see above) out of this
    // grant. This is NOT optional decoration: the "specific match wins" mental model does
    // not apply to Storage rules, so excluding the sub-path from THIS rule's own condition
    // is the only way the deny below actually takes effect instead of being silently OR'd
    // away. The exclusion must not touch `resource` — see the note above.
    //
    // The bare `/tenant/{tenantId}` block exists for `listAll(ref('tenant/<id>'))`: a list
    // is evaluated against the PREFIX path, which has no sub-segment to bind, so the
    // recursive block below does not match it.
    match /tenant/{tenantId} {
      allow read: if inTenant(tenantId);
    }
    match /tenant/{tenantId}/{sub}/{path=**} {
      allow read:           if inTenant(tenantId) && sub != 'private';
      allow create, update: if inTenant(tenantId) && sub != 'private' && sizeOk() && contentTypeOk();
      allow delete:         if inTenant(tenantId) && sub != 'private';
    }

    // ---- album video uploads: the one place the 25 MB cap is lifted ----
    // `tenant/{tid}/section/{sectionKey}/album/...` and `tenant/{tid}/folder/{folderKey}/album/...`
    // are the two paths AlbumStore.addFiles writes to (the second one serves the direct
    // /album/<folderKey> route, whose section is synthesized and has no okey). Same two prefixes
    // the transcoding trigger accepts -- see isAlbumVideoPath in apps/functions/src/video.
    //
    // This block only ever WIDENS: Storage rules OR every matching block's condition together,
    // so the 25 MB grant above stays exactly as it is for everything else under this prefix,
    // and a video simply picks up a second, larger grant here. Nothing is taken away, which is
    // also why `read` and `delete` are deliberately absent -- they are already granted above.
    //
    // The mp4 and jpg renderings live under `.../album/renderings/` and are written by the
    // Admin SDK, which bypasses these rules entirely; they need no grant.
    match /tenant/{tenantId}/{modelType}/{key}/album/{path=**} {
      allow create, update: if inTenant(tenantId)
        && (modelType == 'section' || modelType == 'folder')
        && isVideoUpload() && videoSizeOk() && contentTypeOk();
    }

    // ---- CF-only private data (D-P5-1): subject-access export ZIPs ----
    // Contains a member's AHV number, date of birth and IBAN in plaintext — must never be
    // client-readable. Written only by `exportMyData`, deleted only by `reapPrivacyExports`
    // (both Cloud Functions, which bypass these rules via the Admin SDK); members are
    // served exclusively through the 15-minute signed URL `exportMyData` returns. This
    // block is redundant with the exclusion above (nothing else grants this path either,
    // so the default-deny catch-all at the bottom would already deny it) but is kept
    // explicit given the sensitivity of the data at this path.
    match /tenant/{tenantId}/private/{path=**} {
      allow read, write: if false;
    }

    // ---- esign (plural prefix) ----
    match /tenants/{tenantId}/{path=**} {
      allow read:           if inTenant(tenantId);
      allow create, update: if inTenant(tenantId) && sizeOk() && contentTypeOk();
      allow delete:         if inTenant(tenantId);
    }

    // ---- bare-tenant document path: {tenantId}/{modelType}/{key}/documents/... ----
    // The literal "documents" 4th segment keeps this from matching the tenant/,
    // tenants/, forms/, logo/ or generated-docs/ prefixes.
    match /{tenantId}/{modelType}/{key}/documents/{path=**} {
      allow read:           if inTenant(tenantId);
      allow create, update: if inTenant(tenantId) && sizeOk() && contentTypeOk();
      allow delete:         if inTenant(tenantId);
    }

    // ---- form file uploads (not tenant-scoped; keyed by formKey) ----
    // Authenticated (matches the previous catch-all). Arbitrary content type
    // (form files may be AES-encrypted octet-stream), still size-capped.
    // Mutating existing form files / deletion is restricted to privileged users.
    match /forms/{formKey}/{path=**} {
      allow read:    if signedIn();
      allow create:  if signedIn() && sizeOk() && contentTypeOk();
      allow update, delete: if isPrivileged();
    }

    // ---- global shared brand assets / icons (public, non-sensitive) ----
    match /logo/{path=**} {
      allow read:  if true;
      // `write` covers delete, where request.resource is null — calling contentTypeOk()
      // here would raise "Null value error" and deny every logo deletion. Same reason
      // sizeOk() is never used on a `write`/`delete` rule.
      allow write: if isPrivileged();
    }

    // ---- Cloud-Function-written, served via signed URL (functions bypass rules) ----
    match /generated-docs/{tenantId}/{path=**} {
      allow read:  if inTenant(tenantId);
      allow write: if false;
    }
    match /generated-docs-ephemeral/{tenantId}/{path=**} {
      allow read:  if inTenant(tenantId);
      allow write: if false;
    }

    // ---- default deny: no catch-all grant (H-1) ----
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
