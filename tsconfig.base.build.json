{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "esnext",
    "lib": ["es2021", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@okr/shared-constants": ["dist/libs/shared/constants/src"],
      "@okr/shared-models": ["dist/libs/shared/models/src"],
      "@okr/shared-util-core": ["dist/libs/shared/util-core/src"],
      "@okr/shared-util-functions": ["dist/libs/shared/util-functions/src"],
      "@okr/*": ["dist/libs/*/src"]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
