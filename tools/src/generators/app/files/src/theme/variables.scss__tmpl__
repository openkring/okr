/* Ionic Variables and Theming
 * ---------------------------------------------------------------
 * Any overrides to theme variables should be placed in this file.
 * For more information, please see:
 * http://ionicframework.com/docs/theming/
 */

/**
  ============================================================================
  PLATZHALTER — dieser Mandant hat noch KEINE Markenfarben.
  ============================================================================

  Die Farben unten sind ein bewusst neutrales Schiefergrau. Sie sind KEIN
  Design, sondern ein sichtbares "noch nicht gemacht": eine frisch generierte
  App soll ungebrandet AUSSEHEN, statt fertig auszusehen und dabei die Farben
  eines fremden Mandanten zu tragen.

  (Bis 2026-09 stand hier die Palette des Seeclub Staefa. Vier Mandanten gingen
  damit live und sahen monatelang aus wie ein Ruderclub — eine fertig wirkende
  Palette bringt niemanden zum Nachfragen.)

  SO ERSETZT DU SIE — Details in der Skill `styling`:

    1. Markenwerte suchen. Quelle ist, in dieser Reihenfolge:
       a) apps/<tenant>-website/assets/brand-styleguide.html — der Brand Guide,
          falls vorhanden. Er ist die verbindliche Referenz.
       b) apps/<tenant>-website/assets/site.css (:root)
       c) die Fuellfarben im Logo selbst:
          curl -s https://bkaiser.imgix.net/tenant/<tenant>/logo/logo_round.svg \
            | grep -oE '(fill|stroke)="#[0-9a-fA-F]{3,6}"' | sort -u

    2. Bloecke erzeugen (Shade = 12 % Schwarz, Tint = 10 % Weiss) und dabei jede
       -contrast-Farbe gegen WCAG pruefen — auf einer hellen Markenfarbe ist
       Weiss falsch:
          node .claude/skills/styling/palette.mjs primary=#... secondary=#...

    3. Pruefen, wie schwer eine Rolle wiegt, bevor sie eine blasse Farbe bekommt:
       color="secondary" steht in ~104 Dateien, color="tertiary" in einer.

    4. Die Helfer mitziehen: --bk-fab-background, --bk-banner-background,
       --fa-primary-color, --fa-secondary-color, und den Dark-Mode-Block unten.

    5. success / warning / danger NICHT anfassen — die sind semantisch.

    6. Diesen Kommentar durch einen ersetzen, der sagt, woher jede Rolle kommt.
       Beispiele: apps/kwa-app, apps/elab-app, apps/bka-app.

  Gibt es fuer den Mandanten noch keinen Brand Guide, ist die Skill
  `brand-styleguide` der naechste Schritt: erst die Marke festhalten, dann das
  Theme davon ableiten — nie umgekehrt.
 */
 :root {
  --bk-h1-size: 80px;
  --bk-h2-size: 60px;
  --bk-h3-size: 40px;
  --bk-font-size: 24px;
  --bk-logo-width: 25%;
  --bk-form-margin: auto;
  --bk-form-background: white;
  --bk-form-box-shadow: 0 0 20px 0 rgba(72, 94, 116, 0.7);
  --bk-form-max-width: 600px;
  --bk-form-width: 320px;
  --bk-form-max-height: 600px;
  --bk-form-border-radius: 10px;
  --bk-form-field-background: white;
  --bk-form-field-padding: 0;
  --bk-form-button-padding: 0.5em;
  --bk-banner-background: #475569;  // Platzhalter
  --bk-row-selection-color: lightblue;
  --bk-test-color: #ccffff;
  --bk-light-warning-color: #ffe6993e;
  --bk-archived-color: #ffcc99;
  --bk-fab-background: #475569;  // Platzhalter

  // FontAwesome colouring
  --fa-primary-color: #475569;  // Platzhalter
  --fa-secondary-color: #334155;  // Platzhalter

  /** primary **/
  --ion-color-primary: #475569;
  --ion-color-primary-rgb: 71,85,105;
  --ion-color-primary-contrast: #ffffff;
  --ion-color-primary-contrast-rgb: 255,255,255;
  --ion-color-primary-shade: #3e4b5c;
  --ion-color-primary-tint: #596678;

  /** secondary **/
  --ion-color-secondary: #334155;
  --ion-color-secondary-rgb: 51,65,85;
  --ion-color-secondary-contrast: #ffffff;
  --ion-color-secondary-contrast-rgb: 255,255,255;
  --ion-color-secondary-shade: #2d394b;
  --ion-color-secondary-tint: #475466;

  /** tertiary **/
  --ion-color-tertiary: #94a3b8;
  --ion-color-tertiary-rgb: 148,163,184;
  --ion-color-tertiary-contrast: #000000;
  --ion-color-tertiary-contrast-rgb: 0,0,0;
  --ion-color-tertiary-shade: #828fa2;
  --ion-color-tertiary-tint: #9facbf;

	--ion-color-success: #2dd55b;
	--ion-color-success-rgb: 45,213,91;
	--ion-color-success-contrast: #000000;
	--ion-color-success-contrast-rgb: 0,0,0;
	--ion-color-success-shade: #28bb50;
	--ion-color-success-tint: #42d96b;

	--ion-color-warning: #ffc409;
	--ion-color-warning-rgb: 255,196,9;
	--ion-color-warning-contrast: #000000;
	--ion-color-warning-contrast-rgb: 0,0,0;
	--ion-color-warning-shade: #e0ac08;
	--ion-color-warning-tint: #ffca22;

	--ion-color-danger: #c5000f;
	--ion-color-danger-rgb: 197,0,15;
	--ion-color-danger-contrast: #ffffff;
	--ion-color-danger-contrast-rgb: 255,255,255;
	--ion-color-danger-shade: #ad000d;
	--ion-color-danger-tint: #cb1a27;

	--ion-color-light: #f1f5f9;
	--ion-color-light-rgb: 241,245,249;
	--ion-color-light-contrast: #000000;
	--ion-color-light-contrast-rgb: 0,0,0;
	--ion-color-light-shade: #d4d8db;
	--ion-color-light-tint: #f2f6fa;

	--ion-color-medium: #64748b;
	--ion-color-medium-rgb: 100,116,139;
	--ion-color-medium-contrast: #ffffff;
	--ion-color-medium-contrast-rgb: 255,255,255;
	--ion-color-medium-shade: #58667a;
	--ion-color-medium-tint: #748297;

	--ion-color-dark: #0f172a;
	--ion-color-dark-rgb: 15,23,42;
	--ion-color-dark-contrast: #ffffff;
	--ion-color-dark-contrast-rgb: 255,255,255;
	--ion-color-dark-shade: #0d1425;
	--ion-color-dark-tint: #272e3f;

	--ion-color-white: #ffffff;
	--ion-color-white-rgb: 255,255,255;
	--ion-color-white-contrast: #000000;
	--ion-color-white-contrast-rgb: 0,0,0;
	--ion-color-white-shade: #e0e0e0;
	--ion-color-white-tint: #ffffff;

  @media (max-width: 1580px) {
    --bk-h1-size: 48px;
    --bk-h2-size: 36px;
    --bk-h3-size: 24px;
    --bk-font-size: 18px;
    --bk-logo-width: 33%;
  }
  @media (max-width: 980px) {
    --bk-h1-size: 36px;
    --bk-h2-size: 24px;
    --bk-h3-size: 18px;
    --bk-font-size: 14px;
    --bk-logo-width: 50%;
  }
  @media (max-width: 480px) {
    --bk-h1-size: 24px;
    --bk-h2-size: 18px;
    --bk-h3-size: 14px;
    --bk-font-size: 12px;
    --bk-logo-width: 80%;
  }
}

@media (prefers-color-scheme: dark) {
  :root {
    --ion-color-light: #1e293b;
    --ion-color-light-rgb: 30,41,59;
    --ion-color-light-contrast: #ffffff;
    --ion-color-light-contrast-rgb: 255,255,255;
    --ion-color-light-shade: #1a2434;
    --ion-color-light-tint: #353f4f;
  }
}

.ion-color-white {
  --ion-color-base: var(--ion-color-white);
  --ion-color-base-rgb: var(--ion-color-white-rgb);
  --ion-color-contrast: var(--ion-color-white-contrast);
  --ion-color-contrast-rgb: var(--ion-color-white-contrast-rgb);
  --ion-color-shade: var(--ion-color-white-shade);
  --ion-color-tint: var(--ion-color-white-tint);
}