<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><%= appName %></title>
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= appName %>" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="assets/manifest.json" />
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://firebase.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://firebasestorage.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://identitytoolkit.googleapis.com" />
    <link rel="preconnect" href="https://bkaiser.imgix.net" crossorigin />
    <link rel="icon" href="https://bkaiser.imgix.net/tenant/<%= tenantId %>/logo/favicon.svg" />
    <link rel="mask-icon" href="https://bkaiser.imgix.net/tenant/<%= tenantId %>/logo/mask-icon.svg" color="#000000" />
    <link rel="apple-touch-icon" href="https://bkaiser.imgix.net/tenant/<%= tenantId %>/logo/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  </head>
  <body>
    <okr-root ngSkipHydration>
      <!-- App shell: visible instantly while Angular bootstraps; replaced by the app on mount. -->
      <style>
        .okr-shell {
          position: fixed;
          inset: 0;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          background: #ffffff;
          gap: 24px;
          font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
        }
        .okr-shell__logo {
          width: 144px;
          height: 144px;
        }
        .okr-shell__spinner {
          width: 36px;
          height: 36px;
          border: 3px solid #e0e0e0;
          border-top-color: #3880ff;
          border-radius: 50%;
          animation: okr-spin 0.75s linear infinite;
        }
        @keyframes okr-spin { to { transform: rotate(360deg); } }
        .okr-shell__label {
          font-size: 0.875rem;
          color: #92949c;
          margin: 0;
        }
      </style>
      <!-- The boot-shell logo is the LCP element on purpose (spec 1.49, Teil 2): inline as a data URI so it paints at parse time with no request — a CDN fetch made it lose the race to the app chunks. 144 px keeps it larger than the Angular splash logo (18,291 px²) and the dashboard's largest text block. TODO(provisioning): this generated shell still points `src` at the CDN (https://bkaiser.imgix.net/tenant/<%= tenantId %>/logo/logo_round.svg) instead of a base64 data URI — until you replace it, this app's boot logo loses the LCP race (spike S1, spec 1.49). -->
      <div class="okr-shell">
        <img class="okr-shell__logo"
             src="https://bkaiser.imgix.net/tenant/<%= tenantId %>/logo/favicon.svg"
             alt="<%= appName %>" />
        <div class="okr-shell__spinner"></div>
        <p class="okr-shell__label">Bitte warten…</p>
      </div>
    </okr-root>
    <noscript>Please enable JavaScript to continue using this application.</noscript>
    <!-- ix-player is loaded lazily by Video component only when an album/video section is rendered -->
  </body>
</html>
