// Firebase Messaging Service Worker
// This file handles background push notifications when the app is not in focus

importScripts('https://www.gstatic.com/firebasejs/12.7.0/firebase-app-compat.js');
importScripts('https://www.gstatic.com/firebasejs/12.7.0/firebase-messaging-compat.js');

// Import Firebase configuration (generated at build time from environment)
importScripts('./firebase-config.js');

// Initialize Firebase in the service worker using the generated config
firebase.initializeApp(firebaseConfig);

const messaging = firebase.messaging();

// Same rendition the manifest uses for its 192 px icon. Absent okrTenantId (an old generated
// firebase-config.js) → no icon, and the browser shows its own.
const appIconUrl = typeof okrTenantId === 'string' && okrTenantId
  ? `https://bkaiser.imgix.net/tenant/${okrTenantId}/logo/logo-master.png?w=192&h=192&fm=png&auto=`
  : '';

// Handle background messages
messaging.onBackgroundMessage(payload => {
  console.log('[firebase-messaging-sw.js] Received background message:', payload);

  // One person may hold accounts in several tenants and have several of our apps installed.
  // The sender picks the account of the tenant it speaks for, so a push for another tenant
  // should never reach this worker — but if one does (an old sender, a token registered
  // under the wrong account), a banner for an event this app cannot open is worse than
  // none. `okrTenantId` comes from the generated firebase-config.js; a push without a
  // tenantId (chat via the Matrix push gateway) is shown as before.
  {
    const pushTenant = payload.data?.tenantId;
    const ownTenant = typeof okrTenantId === 'string' ? okrTenantId : '';
    if (pushTenant && ownTenant && pushTenant !== ownTenant) {
      // ⚠️ This must stay the ONLY path that ends without showNotification(). Firefox gives
      // each site a small budget of pushes that show no notification (~16, refilled when the
      // user visits the site) and then REVOKES the push subscription — the token turns
      // "not registered" and every later push is lost. Do not add more silent drops here.
      console.log(`[firebase-messaging-sw.js] Dropped push for tenant ${pushTenant} (this app is ${ownTenant})`);
      return;
    }
  }

  // App-icon badge (spec 1.93): the push names only ITS part of the total (tasks, one new chat
  // message, one new invitation); the ledger holds the rest, written by the open app. The
  // badge promise MUST be part of what this handler returns — iOS suspends the worker as soon
  // as the push event settles, and a fire-and-forget setAppBadge was silently dropped.
  const badgeUpdate = updateBadgeLedger(payload.data || {});

  // "Read elsewhere" sync (spec 1.93 §5): a push must SHOW a notification (iOS/Firefox revoke
  // the subscription after silent ones), so show one under the room's tag — replacing that
  // room's stale chat banner — and close it straight away.
  if (payload.data?.type === 'badge-sync') {
    const tag = payload.data?.tag || 'badge-sync';
    return Promise.all([
      badgeUpdate,
      self.registration.showNotification('Gelesen', { tag, silent: true, data: payload.data })
        .then(() => self.registration.getNotifications({ tag }))
        .then(list => list.forEach(n => n.close()))
        .catch(() => {}),
    ]);
  }

  // Title and body come from data (data-only message) or fall back to notification field
  const notificationTitle = payload.data?.title || payload.notification?.title || 'New Message';

  // iOS PWA silently drops showNotification() when requireInteraction or actions are present
  // (these options are not supported on iOS and cause a silent failure, not a no-op).
  const isVideoCall = payload.data?.type === 'video-call';
  const isIOS = /iP(ad|hone|od)/.test(self.navigator?.userAgent || '');
  const supportsActions = !isIOS && typeof Notification !== 'undefined' && (Notification.maxActions ?? 0) > 0;

  const notificationOptions = {
    body: payload.data?.body || payload.notification?.body || 'You have unread messages',
    // The tenant logo as a PNG rendition from imgix (imgix cannot rasterize SVG — see the
    // `logo` skill). No `badge`: it is drawn as a monochrome silhouette, so a full-bleed logo
    // becomes a white square; the browser's default is better.
    ...(appIconUrl && { icon: appIconUrl }),
    data: payload.data,
    // Per-room tag: a shared tag makes a second sender's message REPLACE the first one's
    // banner instead of stacking, so one of the two is never seen.
    tag: isVideoCall ? 'video-call' : (payload.data?.roomId || payload.data?.channelId || 'default'),
    ...(supportsActions && {
      requireInteraction: isVideoCall,
      actions: isVideoCall
        ? [{ action: 'open', title: 'Anruf öffnen' }, { action: 'dismiss', title: 'Ablehnen' }]
        : [{ action: 'open', title: 'Open Chat' }, { action: 'dismiss', title: 'Dismiss' }],
    }),
  };

  return Promise.all([
    badgeUpdate,
    self.registration.showNotification(notificationTitle, notificationOptions),
  ]);
});

// Handle notification click
self.addEventListener('notificationclick', event => {
  console.log('[firebase-messaging-sw.js] Notification click:', event);
  event.notification.close();

  // No badge write here: a click knows no total. The app opens and its foreground writer
  // sets the true one (spec 1.93 §2.4).

  if (event.action === 'open' || !event.action) {
    const urlToOpen = new URL(event.notification.data?.url || '/', self.location.origin).href;
    event.waitUntil(focusOrOpen(urlToOpen));
  }
});

/**
 * Bring an open app window to the front and route it to `url`, or open a new window.
 *
 * Match on ORIGIN, not on `self.registration.scope`: this worker lives at
 * /firebase-cloud-messaging-push-scope, a path no app URL contains, so a scope match never
 * found the open app and every click opened another tab.
 *
 * `navigate()` only works on a window this worker controls. App windows are controlled by
 * ngsw (scope '/'), so it normally rejects; the page then routes itself on the
 * 'notification-click' message (FcmService.notificationClicks).
 */
async function focusOrOpen(url) {
  const windows = await clients.matchAll({ type: 'window', includeUncontrolled: true });
  const sameOrigin = windows.filter(client => new URL(client.url).origin === self.location.origin);
  const client = sameOrigin.find(c => c.focused) || sameOrigin[0];
  if (!client) {
    return clients.openWindow ? clients.openWindow(url) : undefined;
  }
  await client.focus().catch(() => {});
  try {
    await client.navigate(url);
  } catch {
    client.postMessage({ type: 'notification-click', url });
  }
}

// ---------------------------------------------------------------------------------------------
// App-icon badge ledger (spec 1.93). Plain-JS twin of `applyBadgePush` in
// libs/shared/util-core/src/lib/badge-ledger.util.ts — change both together. One IndexedDB
// record shared with the page (same origin): { chat, tasks, invitations, seen[], fromPage }.
// ---------------------------------------------------------------------------------------------
const BADGE_LEDGER_DB = 'okr-badge';
const BADGE_LEDGER_STORE = 'ledger';
const BADGE_LEDGER_KEY = 'counts';
const BADGE_LEDGER_SEEN_MAX = 100;

function parseBadgeCount(raw) {
  if (raw === undefined || raw === '') return undefined;
  const value = Number.parseInt(raw, 10);
  return Number.isFinite(value) ? Math.max(0, value) : undefined;
}

function applyBadgePush(previous, data, now) {
  const empty = { chat: 0, tasks: 0, invitations: 0, seen: [], fromPage: false, updatedAt: now };
  let next;
  const tasks = parseBadgeCount(data.badgeTasks);
  const chat = parseBadgeCount(data.badgeChat);
  if (tasks !== undefined || chat !== undefined) {
    next = { ...(previous || empty), updatedAt: now };
    if (tasks !== undefined) next.tasks = tasks;
    if (chat !== undefined) next.chat = chat;
  }
  const add = data.badgeAdd;
  const id = data.badgeId || '';
  if ((add === 'chat' || add === 'invitation') && id) {
    const base = next || previous || empty;
    if (!base.seen.includes(id)) {
      const part = add === 'chat' ? 'chat' : 'invitations';
      next = { ...base, [part]: base[part] + 1, seen: [...base.seen, id].slice(-BADGE_LEDGER_SEEN_MAX), updatedAt: now };
    }
  }
  const current = next || previous;
  return {
    ledger: next,
    badge: current && current.fromPage ? current.chat + current.tasks + current.invitations : undefined,
  };
}

function openBadgeLedgerDb() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(BADGE_LEDGER_DB, 1);
    request.onupgradeneeded = () => {
      if (!request.result.objectStoreNames.contains(BADGE_LEDGER_STORE)) {
        request.result.createObjectStore(BADGE_LEDGER_STORE);
      }
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}

/**
 * Apply one push to the ledger (read-modify-write in ONE transaction) and write the badge.
 * Never rejects: a broken ledger must not cost the notification. No ledger written by the
 * page yet ⇒ the badge is left alone (a sum built from zeros would show "1" over a real "7").
 */
async function updateBadgeLedger(data) {
  try {
    const db = await openBadgeLedgerDb();
    const result = await new Promise((resolve, reject) => {
      const tx = db.transaction(BADGE_LEDGER_STORE, 'readwrite');
      const store = tx.objectStore(BADGE_LEDGER_STORE);
      let outcome = { ledger: undefined, badge: undefined };
      const get = store.get(BADGE_LEDGER_KEY);
      get.onsuccess = () => {
        outcome = applyBadgePush(get.result, data, Date.now());
        if (outcome.ledger) store.put(outcome.ledger, BADGE_LEDGER_KEY);
      };
      tx.oncomplete = () => resolve(outcome);
      tx.onerror = () => reject(tx.error);
      tx.onabort = () => reject(tx.error);
    });
    db.close();
    if (result.badge === undefined) return;
    if (result.badge > 0 && self.navigator?.setAppBadge) {
      await self.navigator.setAppBadge(result.badge);
    } else if (result.badge === 0 && self.navigator?.clearAppBadge) {
      await self.navigator.clearAppBadge();
    }
  } catch (error) {
    console.warn('[firebase-messaging-sw.js] badge ledger update failed:', error);
  }
}
