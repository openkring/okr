// to use custom properties from variables.scss
// @import './theme/variables.scss';


/* You can add global styles to this file, and also import other style files */
/*
 * App Global CSS
 * ----------------------------------------------------------------------------
 * Put style rules here that you want to apply globally. These styles are for
 * the entire app and not just one component. Additionally, this file can be
 * used as an entry point to import other CSS/Sass files to be included in the
 * output CSS.
 * For more information on global stylesheets, visit the documentation:
 * https://ionicframework.com/docs/layout/global-stylesheets
 */

/* Core CSS required for Ionic components to work properly */
@import '@ionic/angular/css/core.css';

/* Basic CSS for apps built with Ionic */
@import '@ionic/angular/css/normalize.css';
@import '@ionic/angular/css/structure.css';
@import '@ionic/angular/css/typography.css';

/* Optional CSS utils that can be commented out */
@import '@ionic/angular/css/padding.css';
@import '@ionic/angular/css/float-elements.css';
@import '@ionic/angular/css/text-alignment.css';
@import '@ionic/angular/css/text-transformation.css';
@import '@ionic/angular/css/flex-utils.css';
@import '@ionic/angular/css/display.css';

/**
 * Ionic Dark Palette
 * -----------------------------------------------------
 * For more information, please see:
 * https://ionicframework.com/docs/theming/dark-mode
 */

@import '@ionic/angular/css/palettes/dark.system.css';

/********************* custom style extensions *****************************/

ion-content {
  -webkit-user-select: text;
  user-select: text;
}

ion-modal {
  --background: rgba(44, 39, 45, 0.2);

  &::part(content) {
    backdrop-filter: blur(6px);
  }

  &::part(backdrop) {
    background-color: rgba(209, 213, 219);
    opacity: 1;
  }
}

ion-modal ion-toolbar {
  --background: rgba(14, 116, 144, 0.239);
  --color: white;
}

.full-modal {
  --height: 100%;
  --width: 100%;
}

.upload-modal {
  --height: 200px;
  z-index: 100;
}

.wide-modal {
  --height: 80%;
  --width: 80%;
  --border-radius: 10px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

.map-modal {
  --height: 70%;
  --width: 70%;
  --border-color: black;
  --border_style: solid;
  --border-width: 1px;
  --border-radius: 10px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

.small-modal {
  --height: 50%;
  --width: 50%;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

.list-modal {
  --height: 66%;
  --width: 300px;
  z-index: 101;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

.list-modal-wide {
  --height: 66%;
  --width: 600px;
  z-index: 101;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

/**
 * Auto-height is the DEFAULT for modals: the box shrinks to the height of its content
 * instead of Ionic's fixed 600px desktop default.
 *
 * Ionic gives both `.ion-page` (`contain: layout size style`) and `ion-content`
 * (`height: 100%; contain: size style`) a zero intrinsic height by design — neither can
 * grow with its children. So we relax the *size* containment on both and take
 * ion-content's inner scroll part out of absolute positioning. --max-height caps the
 * growth; beyond that the body scrolls exactly as before.
 *
 * A modal opts OUT by passing one of the fixed-size cssClasses in $fixed-size-modals —
 * do that whenever the body has to fill the box (maps, image/PDF viewers, canvases).
 * Keep that list in sync with the classes defined in this file. `.auto-height-modal`
 * stays available for a modal that carries a fixed-size class but still wants to shrink.
 */
$fixed-size-modals: '.color-modal, .date-modal, .date-modal2, .duration-picker-modal, .full-modal, .full-screen-modal, .fullscreen-modal, .list-modal, .list-modal-wide, .login-modal, .map-modal, .small-modal, .chip-modal, .tag-modal, .time-modal, .upload-modal, .wide-modal, .zoom-modal';

ion-modal:not(:is(#{$fixed-size-modals})),
ion-modal.auto-height-modal {
  --height: auto;
  --max-height: 85vh;
  --border-radius: 10px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);

  &::part(content) {
    position: relative;
    display: block;
    contain: content;
  }

  .ion-page {
    position: relative;
    contain: content;
    max-height: 85vh;
    overflow: auto;
  }

  ion-content {
    height: auto;
    flex: 0 1 auto;
    contain: none;

    // The inner scroll part has to stop being a *scroll container* too, not just
    // be taken out of absolute positioning. Ionic styles it
    // `overflow-y: auto; overscroll-behavior-y: contain`; flowed out of `position:
    // absolute` it grows with its content and has nothing left to scroll, but
    // `overscroll-behavior: contain` still swallows the wheel/touch gesture instead
    // of chaining it to the scrolling .ion-page above — so a modal taller than
    // --max-height could not be scrolled at all from within its body.
    // `overflow: visible` must set BOTH axes: a `hidden`/`visible` pair computes
    // back to `auto` and the element would stay a scroll container.
    &::part(scroll) {
      position: relative;
      overflow: visible;
    }
  }

  // Once the content does exceed --max-height, the .ion-page scrolls — keep the
  // header toolbar (and its close button) and the save/cancel bar in view.
  //
  // A sticky element can only move inside its own containing block, i.e. inside
  // its PARENT box. `<ion-header>` sits inside the `<okr-header>` wrapper element,
  // which is exactly as tall as the header itself — so sticking ion-header there
  // does nothing. The wrapper components have to be the sticky elements instead;
  // their parent is the modal component host, which spans the whole scrolled body.
  //
  // The change-confirmation bar stacks directly below the header, so its offset is
  // the header height. A modal whose header carries more than one toolbar overrides
  // --okr-sticky-header-height on its host.
  --okr-sticky-header-height: 56px; // md toolbar min-height

  html.ios & {
    --okr-sticky-header-height: 44px; // ios toolbar min-height
  }

  ion-header,
  okr-header,
  okr-change-confirmation {
    display: block;
    position: sticky;
    // ion-modal ion-toolbar is translucent — without an opaque backing the scrolled
    // content would show through the pinned bars.
    background: var(--ion-background-color, #fff);
  }

  ion-header,
  okr-header {
    top: 0;
    z-index: 11;
  }

  okr-change-confirmation {
    top: var(--okr-sticky-header-height);
    z-index: 10;
  }
}

.zoom-modal {
  --height: 600px;
  --width: 600px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

.login-modal {
  --height: 300px;
  --width: 400px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

.date-modal {
  --height: 480px;
  --width: 400px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

.date-modal2 {
  --height: 550px;
  --width: 400px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

// Generic from/to duration picker (bk-duration-picker-modal): two calendars side by side.
.duration-picker-modal {
  --height: 600px;
  --width: 800px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);

  // left-aligned modal title (matches other forms)
  ion-title {
    text-align: start;
    padding-inline-start: 16px;
  }

  // prominent "Von" / "Bis" headers above each calendar
  .duration-header {
    background: var(--ion-color-light);
    color: var(--ion-color-light-contrast);
    font-weight: 600;
    text-align: center;
    padding: 8px 12px;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  ion-datetime {
    margin-inline: auto;
  }

  // stack the two calendars on narrow screens
  @media (width <= 700px) {
    --width: 96%;
    --height: 90%;
  }
}

.time-modal {
  --height: 330px;
  --width: 250px;
  z-index: 100;
  --border-radius: 10px;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

.tag-modal {
  --height: 480px;
  --width: 400px;
  z-index: 100;
  --border-radius: 10px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
}

.color-modal {
  --height: 430px;
  --width: 230px;
  z-index: 100;
  --border-color: black;
  --border-style: solid;
  --border-width: 1px;
  --border-radius: 10px;
  --box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);
}

ion-modal.stack-modal {
  --box-shadow: 0 28px 48px rgba(0, 0, 0, 0.4);
  --backdrop-opacity: var(--ion-backdrop-opacity, 0.32);
}

/* Force hover & activated states in ALL popovers, e.g. bk-cat-select */
.raw-message-alert .alert-message {
  text-align: left;
}

.bk-prompt-alert {
  --width: min(92vw, 560px);

  .alert-input-group textarea {
    min-height: 120px;
    resize: vertical;
  }
}

.custom-action-sheet {
  .action-sheet-divider {
    height: 4px !important;           // or 1px for thin line
    background: var(--ion-color-light) !important;
    pointer-events: none;
    min-height: 4px !important;
    padding-top: 1px;
    padding-bottom: 1px;
  }

  .action-sheet-group button.action-sheet-divider {
    border-top: none !important;
    border-bottom: none !important;
  }
}

ion-popover ion-item {
  --ion-item-background-hover: var(--ion-color-light) !important;
  --ion-item-color-hover: var(--ion-color-primary) !important;
}

ion-popover ion-item.active,
ion-popover ion-item[button]:active {
  --ion-item-background: var(--ion-color-primary) !important;
  --ion-item-color: var(--ion-color-primary-contrast) !important;
}

ion-popover ion-item.hover {
  --ion-item-background: var(--ion-color-light) !important;
  --ion-item-color: var(--ion-color-primary) !important;
}

.fullscreen-modal {
  --width: 100%;
  --height: 100%;
  --border-radius: 0;
}

// CDK drag-and-drop appends the drag preview to document.body, which sits behind
// Ionic modals (z-index ~20000). Lift it above so dragging inside a modal is visible.
.cdk-drag-preview {
  z-index: 100000 !important;
}
.cdk-drag-placeholder {
  opacity: 0.3;
}
