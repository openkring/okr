import './init-sentry';
import { bootstrapApplication } from '@angular/platform-browser';
import { OkrRoot } from './app/okr-root';
import { appConfig } from './app/app.config';
import { getApp } from 'firebase/app';
import { initializeAppCheck, ReCaptchaEnterpriseProvider, getToken } from 'firebase/app-check';
import { registerAppCheck } from '@okr/shared-config';
import { markStartup } from '@okr/shared-util-angular';
import { environment } from './environments/environment';

// Initialize App Check BEFORE bootstrapping the app, but do NOT wait for its token.
function initializeApp() {
  if (typeof window !== 'undefined') {
    // Only use debug token in development (NOT in production)
    if (!environment.production) {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      (<any>window).FIREBASE_APPCHECK_DEBUG_TOKEN = true;
    }
    
    markStartup('appcheck:start');
    const appCheck = initializeAppCheck(getApp(), {
      provider: new ReCaptchaEnterpriseProvider(environment.services.appcheckRecaptchaEnterpriseKey),
      isTokenAutoRefreshEnabled: true,
    });

    // Hand the instance to @okr/shared-config so libs can await a valid token before a
    // resume-time write (Safari suspends the auto-refresh timer in backgrounded tabs).
    registerAppCheck(appCheck);

    // Pre-warm the App Check token WITHOUT blocking bootstrap. initializeAppCheck() above is
    // what matters for correctness: from that point the Firebase SDK attaches an App Check
    // token to every Firestore/Auth request and waits for it internally. Awaiting getToken()
    // here only pre-filled the cache — at the cost of serializing a reCAPTCHA Enterprise
    // script download + attestation round-trip (up to the old 5 s timeout) AHEAD of the whole
    // Angular bootstrap, so auth restore and the first Firestore reads queued behind it.
    // Firing it un-awaited keeps the pre-warm but overlaps it with bootstrap + auth restore.
    // The catch still matters: on privacy-hardened browsers (e.g. Firefox with Enhanced
    // Tracking Protection) the reCAPTCHA script can be blocked and this rejects — which must
    // not surface as an unhandled rejection.
    getToken(appCheck).then(
      () => { markStartup('appcheck:ok'); },
      (error) => {
        markStartup('appcheck:failed');
        if (!environment.production) {
          console.warn('App Check token failed in development - continuing anyway.');
          console.warn('To fix: Copy the debug token from console and add it in Firebase Console → App Check → Manage debug tokens');
        } else {
          console.error('App Check token failed:', error);
        }
      },
    );
  }

  // Bootstrap immediately — App Check attestation resolves in parallel.
  markStartup('bootstrap:call');
  bootstrapApplication(OkrRoot, appConfig).catch(err => console.error(err));
}

initializeApp();

// firebase-messaging-sw.js is auto-registered by the Firebase Messaging SDK at scope
// /firebase-cloud-messaging-push-scope/ on the first getToken() call inside FcmService.
// No manual registration here — leaving root scope (/) free for ngsw-worker.js (see
// docs/16_spec-pwa-caching.md §5.1).
