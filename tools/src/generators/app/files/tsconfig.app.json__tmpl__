{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "../../dist/out-tsc/apps/<%= tenantId %>-app",
    "module": "preserve",
    "target": "es2022",
    "types": ["node"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["dom", "es2022"],
    "ignoreDeprecations": "6.0",
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.spec2.ts", "vite.config.ts", "**/bka-setup.ts", "node_modules"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
