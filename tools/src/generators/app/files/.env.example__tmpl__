# <%= tenantId %>-app environment template — copy to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real secrets. Values are provisioned per
# developer / per deploy (GCP Secret Manager for CI/functions).
#
# After filling this in:  source ./apps/<%= tenantId %>-app/.env && node ./set-env.js
# (generates src/environments/environment.ts — also git-ignored)

# App identity
APP_ID=<%= tenantId %>-app

# GetStream chat
STREAM_API_KEY=

# Firebase web app config (JSON blob from Firebase console → Project settings)
FIREBASE_WEBAPP_CONFIG=

# Firebase App Check (reCAPTCHA v3 site key — public, but keep out of git)
NEXT_PUBLIC_FIREBASE_RECAPTCHA_KEY=

# Google Maps JS API key
NEXT_PUBLIC_SVC_GMAP_KEY=

# Nx Cloud access token
NEXT_PUBLIC_NX_CLOUD_ACCESS_TOKEN=

# imgix image CDN base URL
NEXT_PUBLIC_IMGIX_BASE_URL=

# FCM web push VAPID key
FCM_VAPID_KEY=

# Sentry — every tenant reports into its OWN Sentry project, named after the tenantId.
# Create the project first (org bkaiser-gmbh, region https://de.sentry.io), then paste its
# Default DSN here. The DSN — not SENTRY_PROJECT — decides where events land; SENTRY_PROJECT
# only steers the source-map upload, so the two must name the same project or stack traces
# stay minified.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG='bkaiser-gmbh'
SENTRY_PROJECT='<%= tenantId %>'
# Org-wide auth token for the source-map upload (same value for every tenant).
SENTRY_AUTH_TOKEN=
