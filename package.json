  "name": "okr",
  "version": "7.51.3",
  "packageManager": "pnpm@12.10.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run scs-app:build:production",
    "build:affected": "nx affected -t build",
    "build:functions": "nx build functions",
    "build:p13-css": "tailwindcss -c apps/p13-website/tailwind.config.js -i apps/p13-website/tailwind.input.css -o apps/p13-website/assets/tailwind.css --minify",
    "build:web-css": "tailwindcss -c apps/scs-website/tailwind.config.js -i apps/scs-website/tailwind.input.css -o apps/scs-website/assets/tailwind.css --minify",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "serve": "nx serve",
    "test": "nx test",
    "test:affected": "nx affected -t test --parallel=3 --outputStyle=static",
    "testlibs": "NODE_OPTIONS='--max-old-space-size=8192' pnpm nx run-many --target=test --all --exclude=okr,scs-app",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' nx lint",
    "attribution": "node scripts/gen-attribution.mjs",
    "attribution:check": "node scripts/gen-attribution.mjs --check",
    "catalogue:check": "node scripts/check-feature-catalogue.mjs",
    "catalogue:doc": "node scripts/check-feature-catalogue.mjs --write-doc",
    "check-forms": "node scripts/check-forms.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-menu-labels": "node scripts/check-menu-labels.mjs",
    "check-skill-contents": "node scripts/check-skill-contents.mjs",
    "lib-refs": "node scripts/gen-lib-references.mjs",
    "lib-refs:write": "node scripts/gen-lib-references.mjs --write",
    "logo:gen": "node scripts/gen-logo-assets.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "e2e": "nx e2e",
    "dev": "nx serve scs-app",
    "release": "node scripts/release.mjs",
    "session:new": "node scripts/session-worktree.mjs new",
    "session:sync": "node scripts/session-worktree.mjs sync",
    "session:list": "node scripts/session-worktree.mjs list",
    "session:remove": "node scripts/session-worktree.mjs remove",
    "format": "nx run-many --target=format --all",
    "format:check": "nx run-many --target=format:check --all",
    "export-i18n": "source ./apps/scs-app/.env && ts-node -P scripts/tsconfig.json scripts/export-i18n.ts",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs scs-app"
  },
