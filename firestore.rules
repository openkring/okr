rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    //  Helpers — authorization is derived from the caller's users/{uid} document,
    //  NOT from custom claims. Custom claims (token.admin / token.contentAdmin /
    //  token.tenantId) are never minted anywhere in this project, so claim-based
    //  checks would always be false. The user doc carries:
    //    - roles:   map<RoleName, bool>   (e.g. { admin: true, contentAdmin: true })
    //    - tenants: string[]              (always exactly one tenant per user)
    //  Every stored model carries tenants: string[]; the 'system' tenant denotes
    //  shared/global data readable by every tenant.
    // ============================================================================

    function signedIn() {
      return request.auth != null;
    }
    // Server badge ledger users/{uid}/badge/counts (spec 1.127 §3.7): only these keys, parts are
    // integers in 0..9999, seen is a short list, fromApp a bool, updatedAt a string or timestamp
    // (the server writes serverTimestamp(), and a client merge write sees the merged document).
    function validBadgePart(d, k) {
      return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= 9999);
    }
    function validBadgeLedger(d) {
      return d.keys().hasOnly(['chat', 'tasks', 'invitations', 'seen', 'fromApp', 'updatedAt'])
        && validBadgePart(d, 'chat') && validBadgePart(d, 'tasks') && validBadgePart(d, 'invitations')
        && (!('seen' in d) || (d.seen is list && d.seen.size() <= 200))
        && (!('fromApp' in d) || d.fromApp is bool)
        && (!('updatedAt' in d) || d.updatedAt is string || d.updatedAt is timestamp);
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userExists() {
      return signedIn() && exists(userPath());
    }
    function userData() {
      return get(userPath()).data;
    }
    function callerTenants() {
      return userExists() ? userData().tenants : [];
    }
    function hasRole(role) {
      return userExists() && userData().roles.get(role, false) == true;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    // Operator (spec 1.101): the users doc has tenants exactly ['bka'] AND roles.admin.
    // Mirrors isOperatorUserData / checkOperatorTenant in @okr/shared-util-functions.
    function isOperator() {
      return isAdmin() && userData().tenants == ['bka'];
    }
    function isPrivileged() {
      return hasRole('privileged') || isAdmin();
    }
    // CMS content (pages/sections/menuItems/categories) is authored in the
    // privileged CMS UI; writes require the content role (M-7).
    function isContentManager() {
      return hasRole('contentAdmin') || isPrivileged();
    }
    // Learning rooms (spec 1.115 §6): administering a room (its section config, publishing) is for
    // contentAdmin/admin only — narrower than isContentManager, which also admits `privileged`.
    function isContentAdminOrAdmin() {
      return hasRole('contentAdmin') || isAdmin();
    }
    // pages update: publishing or unpublishing a learning room (isPrivate) needs contentAdmin/admin.
    function learningPublishOk() {
      return (resource.data.get('type', '') != 'learning' && request.resource.data.get('type', '') != 'learning')
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPrivate', 'type'])
        || isContentAdminOrAdmin();
    }
    // pages create/delete: a learning page can be neither created nor deleted by a plain content manager
    // (else delete + recreate under the same key with isPrivate false would bypass the publish gate).
    function learningPageCreateOk() {
      return request.resource.data.get('type', '') != 'learning' || isContentAdminOrAdmin();
    }
    function learningPageDeleteOk() {
      return resource.data.get('type', '') != 'learning' || isContentAdminOrAdmin();
    }
    // sections create/update/delete: a learning section (curators, folder, topics) needs contentAdmin/admin.
    function learningSectionWriteOk() {
      return isContentAdminOrAdmin()
        || ((resource == null || resource.data.get('type', '') != 'learning')
            && (request.resource == null || request.resource.data.get('type', '') != 'learning'));
    }
    // ── addresses vault (privacy 1.19 Phase 4 lock) ─────────────────────────────
    // The caller owns an address when its parentKey points at their own person.
    function ownsParent(data) {
      return userExists() && data.parentKey == 'person.' + userData().personKey;
    }
    // Sensitive scalar channels: values whose channel floor is `privileged` —
    // never readable at the registered tier, writes gated below.
    function isSensitiveChannel(data) {
      return data.addressChannel in ['ssn', 'dob', 'dod', 'bankaccount'];
    }
    // Who may write sensitive-channel addresses: the owner (self-service),
    // privileged, or memberAdmin (authorized editor per D9).
    function canWriteSensitive(data) {
      return ownsParent(data) || isPrivileged() || hasRole('memberAdmin');
    }
    // Who may read the vault at all (D-P4-1, amended 2026-07-27): owner,
    // privileged, or memberAdmin. memberAdmin is the authorized ssn/dob editor
    // (D9) and could already obtain every value through the getAddressView
    // callable, so denying the raw read bought no confidentiality — it only
    // broke read-then-write flows (duplicate vault docs) and the QR-slip/export
    // paths. Plain members remain locked out; they read the projection.
    function canReadVault(data) {
      return ownsParent(data) || ((isPrivileged() || hasRole('memberAdmin')) && belongsToTenant(data));
    }
    // ── avatars (privacy 1.19, D-P4-10) ─────────────────────────────────────────
    // A person's avatar is a picture OF that person; the avatar doc id is the prefixed
    // key `person.<personKey>` (newAvatarModel). Until 2026-08-01 any member of the
    // tenant could create or replace it, i.e. upload a portrait of someone else as that
    // person's picture — precisely the case the photo declaration (`usageImages`) is
    // about. Person avatars are therefore owner-or-memberAdmin; every other avatar
    // (org, resource, section, …) stays ordinary tenant content, written by whoever
    // maintains that record. This is a write gate only: it does NOT make `usageImages`
    // enforceable — the bytes are served unsigned from the imgix CDN.
    // The doc id is tenant-scoped (`p13.person.kaiser`, this tenant's own picture) or bare
    // (`person.kaiser`, the shared default every tenant falls back to) — both shapes count.
    function isPersonAvatar(id) {
      return id.matches('^([^.]+[.])?person[.].*');
    }
    function canWriteAvatar(id) {
      return !isPersonAvatar(id)
             || id.matches('^([^.]+[.])?person[.]' + callerPersonKey() + '$')
             || isPrivileged() || hasRole('memberAdmin');
    }
    // A document belongs to the caller's tenant when their tenant is listed on the
    // document, or when the document is shared via the 'system' tenant.
    //
    // READ ONLY. The 'system' sentinel makes a document readable fleet-wide; it must never
    // make one WRITABLE fleet-wide. Those are different questions and, until 2026-08-25, this
    // one predicate answered both — so every `tenantCreate()`/`tenantUpdate()`/`tenantDelete()`
    // would have let ANY signed-in user of ANY tenant rewrite or archive a shared document that
    // the whole fleet reads. That never fired only because no document actually carried
    // 'system' (verified across all 72 collections); the icons migration is the first, which is
    // why the split lands with it. Writes go through canWriteTenant() below.
    function belongsToTenant(data) {
      return data.tenants.hasAny(callerTenants()) || data.tenants.hasAny(['system']);
    }
    // WRITE. Strictly the caller's own tenant — 'system' is NOT accepted for tenant users, so
    // fleet-shared reference data is curated centrally: Admin SDK / scripts, or the operator
    // (admin of exactly ['bka'], see isOperator) from the bka app. Mirrored client-side by
    // canWriteTenant() in `query.util.ts`.
    function canWriteTenant(data) {
      return canWriteTenantFor(data, callerTenants());
    }
    // `ts` = callerTenants(), passed in so a caller checking two docs evaluates it once.
    function canWriteTenantFor(data, ts) {
      return data.tenants.hasAny(ts)
             || (data.tenants.hasAny(['system']) && isOperator());
    }
    // A get() on a NON-EXISTENT document evaluates rules with resource == null.
    // Dereferencing resource.data.tenants there raises an error → the client sees
    // "Missing or insufficient permissions" instead of a clean not-found (breaks the
    // common read-then-create / existence-check pattern, e.g. FolderService.
    // ensureGroupFolder). Reading a non-existent doc returns nothing, so allow it;
    // list/query results always have a concrete resource, so belongsToTenant still
    // fully gates real data.
    function tenantRead() {
      return userExists() && (resource == null || belongsToTenant(resource.data));
    }
    function tenantCreate() {
      return userExists() && canWriteTenant(request.resource.data);
    }
    // Deleting a SHARED document in one tenant detaches that tenant instead of archiving
    // it (FirestoreService.deleteModel / getDeletePatch) — the doc stays live for the
    // others. That write leaves a document the caller no longer belongs to, which
    // belongsToTenant(request.resource.data) would deny. Allow exactly that shape:
    // `tenants` is the ONLY changed field, the new value is the old minus the caller's own
    // tenant (so nobody can evict a foreign tenant), and at least one tenant survives —
    // a doc with tenants: [] would be readable by nobody and recoverable by no one, which
    // is precisely why the last tenant sets isArchived instead.
    function selfDetach() {
      return userExists()
             && canWriteTenant(resource.data)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenants'])
             && request.resource.data.tenants == resource.data.tenants.removeAll(callerTenants())
             && request.resource.data.tenants.size() > 0;
    }
    // callerTenants() is bound once: every call re-evaluates signedIn/exists/get, and a
    // calevent course move (1.132) already sits near the 1000-expression limit of one
    // evaluation. No leading userExists(): without a user `ts` is [] and isOperator() fails.
    function tenantUpdate() {
      let ts = callerTenants();
      return canWriteTenantFor(resource.data, ts)
             && (canWriteTenantFor(request.resource.data, ts) || selfDetach());
    }
    // For the `allow create, update: if tenantCreateOrDetach()` one-liners: a create
    // (resource == null) is tenantCreate(), an update is the full tenantUpdate() — the
    // caller's tenant must be on the STORED doc, not only on the new one. Until 2026-11-02
    // this was `tenantCreate() || selfDetach()`, which on an update checked only
    // request.resource.data, so an admin of t2 could PATCH a t1 doc to tenants: ['t2'] and
    // take it over; the stored-tenant check is not redundant.
    function tenantCreateOrDetach() {
      return resource == null ? tenantCreate() : tenantUpdate();
    }
    function tenantDelete() {
      return userExists() && canWriteTenant(resource.data);
    }
    // The `index` search string is a plain field on a tenant-readable document, so a
    // sensitive value embedded there (`dob:19850101`) leaks past the field-level
    // resurrection guard — that is exactly how the stripped dob survived Phase 4 in
    // production until 2026-07-27 (rebuilt by scripts/rebuild-person-index.mjs).
    // matches() is full-string RE2, hence the leading/trailing `.*`.
    function indexHasNoSensitivePii() {
      return !request.resource.data.get('index', '').matches('.*(dob|ssn|iban):.*');
    }
    // personKey of the caller (from their users/{uid} doc); '' when absent.
    function callerPersonKey() {
      return userExists() ? userData().get('personKey', '') : '';
    }
    // Tracker trips (spec 1.121): a trip of type 'tracker' is shared across the person's
    // tenants (e.g. ['bkg','bka']) but belongs to ONE person, track.personKey — only the
    // caller whose users/{uid}.personKey matches may read or write it, in any tenant.
    // Every other trip type passes; legacy trips without a `type` field count as non-tracker.
    function isTrackOwner(data) {
      return data.get('type', '') != 'tracker' || isTrackOwnerOf(data);
    }
    function isTrackOwnerOf(data) {
      return callerPersonKey() != '' && data.get('track', {}).get('personKey', '') == callerPersonKey();
    }
    // LIST variant. Rules are not filters: every trips list query must carry a type
    // constraint that excludes 'tracker' (type in NON_TRACKER_TRIP_TYPES, type == 'travel'),
    // or — for the owner — type == 'tracker' plus track.personKey == <own personKey>;
    // otherwise the whole query is denied. It must read `data.type` WITHOUT a get() default:
    // the query evaluator substitutes the default for an unconstrained field, so
    // get('type', '') != 'tracker' proves true for a query with no type filter and returns
    // other people's tracker trips (verified in the emulator, spec 1.121 task 8).
    function isListableTrip(data) {
      return data.type != 'tracker' || isTrackOwnerOf(data);
    }
    // Folder lookup for member-upload / folder-owner checks (spec 1.22).
    function folderData(folderKey) {
      return get(/databases/$(database)/documents/folders/$(folderKey)).data;
    }
    // Learning-room folder (spec 1.115 §7.2): a doc whose first folder is flagged learningRoom is
    // managed only by content managers/admins (and the Admin SDK callables), never by its author or
    // the folder owner. A missing folder is not a room (exists() guard, no evaluation error).
    function inLearningRoom(folderKeys) {
      return folderKeys.size() > 0
        && exists(/databases/$(database)/documents/folders/$(folderKeys[0]))
        && folderData(folderKeys[0]).get('learningRoom', false) == true;
    }

    // ============================================================================
    //  Public read — only what an unauthenticated client genuinely renders.
    //
    //  The public-facing static websites (apps/*-website) do NOT read Firestore
    //  directly — they fetch curated, field-mapped JSON from the publicApi Cloud
    //  Function (server-side, Admin SDK), which is the single public gateway.
    //
    //  The only browser path that reads Firestore anonymously is the PWA's
    //  public/* landing (cms-page PageDispatcher → pages + sections, ungated),
    //  plus the app-config / app-version bootstrap docs. Everything else
    //  (orgs/resources/tags/categories) is loaded by AppStore only after login
    //  (its resources are gated on fbUser), so it must NOT be world-readable.
    //
    //  CMS content (pages/sections/menuItems/categories) writes are content-role
    //  gated (M-7).
    // ============================================================================

    match /app-config/{tenant} {
      allow read: if true;
      // App configuration is admin territory — but only for your OWN tenant: the
      // doc id IS the tenantId, so without this check a privileged user of tenant A
      // could overwrite app-config/B.
      //
      // Create and delete are split (spec 1.115 fix round 2): with one shared
      // `isPrivileged()` arm, a privileged non-admin could delete the doc and recreate it
      // with any `fileTransferLimits` or `enabledFeatures`, around the update guards
      // below. Delete is admin-only; a create that carries either guarded field is too.
      // No client deletes or creates app-config today (provisioning uses the Admin SDK).
      allow create: if isPrivileged() && (tenant in callerTenants())
        && (isAdmin() || !request.resource.data.keys().hasAny(['fileTransferLimits', 'enabledFeatures']));
      allow delete: if isAdmin() && (tenant in callerTenants());
      // ...except for the fields that are NOT the tenant's own business.
      //
      // `enabledFeatures` is a BILLING boundary (1.32 §8.5): a tenant admin who can
      // switch on a paid add-on is one who can stop paying for it. Feature selection is
      // server-side by design anyway (D-BB-9 — the `applyFeatureSelection` callable uses
      // the Admin SDK and bypasses rules), so denying it here costs the client nothing;
      // `feature-selection.service.ts` never writes the field.
      //
      // The same list takes the E2EE key-management flag when 1.33 lands. There it is a
      // SECURITY boundary, and sharpest in the DOWNGRADE direction — a tenant admin must
      // not be able to turn self-managed keys back off for everyone.
      //
      // `affectedKeys()` reports only keys whose value actually CHANGED, so the AOC
      // config editor writing the whole document back with the field untouched still passes.
      //
      // `fileTransferLimits` (spec 1.115 §4.4) is admin-only: it holds the per-person
      // overrides, so a privileged non-admin could otherwise raise their own limit.
      allow update: if isPrivileged() && (tenant in callerTenants())
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['enabledFeatures'])
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['fileTransferLimits']));
    }
    match /app-version/{doc} {
      allow read: if true;
      allow write: if false;                          // updated out-of-band / by admin tooling
    }
    // Global chat switch (spec 1.107): one doc app-status/chat for ALL tenant apps.
    // Deliberately not tenant-scoped (no tenants[]); any signed-in user reads it,
    // only the operator (tenant bka, spec 1.101 phase 4) writes it.
    // Only the chat doc: any other app-status/* falls through to the default deny.
    match /app-status/chat {
      allow read: if signedIn();
      allow write: if isOperator();
    }
    // Mail delivery telemetry (spec 1.101 phase 5): written only by the onWebhookEvent Cloud
    // Function (Admin SDK, bypasses rules); the cross-tenant AOC e-mail page is operator-only.
    match /emailEvents/{id} {
      allow read: if isOperator();
      allow write: if false;
    }
    // Global integration config singletons (e.g. config/bexioSync sync pointers).
    // Read by the admin-only AOC console; written exclusively by Cloud Functions
    // (Admin SDK, bypasses rules).
    match /config/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Server-only secrets (per-tenant API keys, e.g. searchChApiKey). Never
    // client-readable/writable; Cloud Functions reach these via the Admin SDK,
    // which bypasses these rules.
    match /app-secrets/{tenantId} {
      allow read, write: if false;
    }
    // CMS content rendered by the anonymous PWA landing — public read.
    match /pages/{id}           { allow read: if true; allow create: if isContentManager() && tenantCreateOrDetach() && learningPageCreateOk(); allow update: if isContentManager() && tenantCreateOrDetach() && learningPublishOk(); allow delete: if isContentManager() && canWriteTenant(resource.data) && learningPageDeleteOk(); }
    match /sections/{id}        { allow read: if true; allow create, update: if isContentManager() && tenantCreateOrDetach() && learningSectionWriteOk(); allow delete: if isContentManager() && canWriteTenant(resource.data) && learningSectionWriteOk(); }
    // menuItems/categories: navigation + select metadata. menuItems is read by the
    // app shell's menu store (ungated); categories are CMS select-lists. Low
    // sensitivity, kept public-readable; writes are content-role gated.
    match /categories/{id}      { allow read: if true; allow create, update: if isContentManager() && tenantCreateOrDetach(); allow delete: if isContentManager() && canWriteTenant(resource.data); }
    // Fork-on-edit (feature-building-blocks D-BB-8): a tenant customising a SHARED,
    // catalogue-owned menu doc copies it and then detaches itself from the original. That
    // detach leaves a document the caller no longer belongs to, so the ordinary
    // belongsToTenant(request.resource.data) check would deny it. Allow exactly that one
    // shape: the caller already belonged, `tenants` is the ONLY field changed, and the new
    // value is the old one minus the caller's own tenant — so it can drop itself and nobody
    // else, and cannot smuggle any other edit through the same write.
    function isSelfDetach() {
      return isContentManager()
             && canWriteTenant(resource.data)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenants'])
             && request.resource.data.tenants == resource.data.tenants.removeAll(callerTenants());
    }
    // Nobody may evict ANOTHER tenant from a shared menu doc — that would break their menu
    // from across the tenant boundary. Un-seeding is applyFeatureSelection's job (Admin SDK,
    // rules bypassed), never a client's. Every tenant but the caller's own must survive the
    // write; the caller's own may go (that is isSelfDetach) or stay (an ordinary edit).
    function keepsForeignTenants() {
      return request.resource.data.tenants.hasAll(resource.data.tenants.removeAll(callerTenants()));
    }
    match /menuItems/{id}       { allow read: if true; allow create: if isContentManager() && canWriteTenant(request.resource.data); allow update: if keepsForeignTenants() && ((isContentManager() && canWriteTenant(request.resource.data)) || isSelfDetach()); allow delete: if isContentManager() && canWriteTenant(resource.data); }
    // tags/orgs/resources: NOT public. Read only by authenticated tenant members
    // (AppStore loads them post-login). The static websites get any org info via
    // the publicApi CF, never by reading these collections directly. (M-7)
    match /tags/{id}            { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // orgs: resurrection guard (spec 1.19 Phase 4) — stripped favEmail/favPhone
    // must never reappear on the doc.
    match /orgs/{id} {
      allow read:   if tenantRead();
      allow create: if tenantCreate() && !request.resource.data.keys().hasAny(['favEmail', 'favPhone']);
      allow update: if tenantUpdate() && !request.resource.data.keys().hasAny(['favEmail', 'favPhone']);
      allow delete: if tenantDelete();
    }
    match /resources/{id}       { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }

    // ============================================================================
    //  Users — own doc, with role/tenant/personKey escalation blocked. (C-1)
    // ============================================================================

    match /users/{userId} {
      // loginId / loginEmail are the login identity. Only Cloud Functions (Admin SDK) write them —
      // uniqueness per tenant is checked there (spec 1.71 §3). get(…, '') makes a legacy doc without
      // the field equal to a client that writes the model default ''.
      function loginIdentityUnchanged() {
        return request.resource.data.get('loginId', '') == resource.data.get('loginId', '')
            && request.resource.data.get('loginEmail', '') == resource.data.get('loginEmail', '');
      }

      // Operator status (bka-only callables) = users doc tenants exactly ['bka'] + roles.admin
      // (spec 1.101). Invariant: a users doc holds exactly ONE tenant (live data: 322 of 322),
      // and an admin only touches docs whose tenants are all their own. Escalation chains this
      // closes: (a) widen own tenants to ['scs','bka'], then narrow to ['bka']; (b) delete a
      // second account U, self-create U with ['bka','scs'], make it admin via the update arm,
      // let it delete/recreate the first admin as ['bka']. Hence: self-create needs exactly one
      // tenant, admin create needs a single-tenant caller and a single own tenant, admin
      // update/delete need every tenant of the doc to be the caller's, and update never changes
      // `tenants`. Tenant moves happen server-side (Admin SDK) only.
      function singleOwnTenant(data) {
        return data.tenants.size() == 1 && callerTenants().size() == 1
            && callerTenants().hasAll(data.tenants);
      }

      // Read your own doc; admins/privileged may read others within their tenant.
      // The `resource == null` arm is the same guard tenantRead() carries: a get() on a
      // NON-EXISTENT user doc evaluates rules with resource == null, and dereferencing
      // resource.data.tenants there raises an error → the client sees "Missing or
      // insufficient permissions" instead of a clean not-found. That broke the
      // read-then-create pattern in FirestoreService.createModel, whose existence-guard
      // transaction GETS users/{uid} before writing it — so an admin could not provision a
      // user account at all (kwa-app, 2026-09-10). A list/query always has a concrete
      // resource, so belongsToTenant still fully gates real data.
      allow read: if signedIn() && (request.auth.uid == userId
                    || (isPrivileged() && (resource == null || belongsToTenant(resource.data))));

      // Only admins create users docs from the client, and only within their own single tenant.
      // There is NO self-service create (spec 1.101 phase 1): Firebase Auth issues a valid ID token
      // for a login that has no users doc, and the app's guards don't apply to direct SDK calls, so
      // a self-create arm let such a login make itself a member of any tenant. Accounts are
      // provisioned by admins or server-side (Admin SDK: openAccount / syncPersonAccount,
      // allocateTenant), which bypasses rules.
      // A client-created user doc may never carry a Benutzername — admins provision
      // accounts through the openAccount callable, which writes loginId server-side.
      allow create: if signedIn() && request.resource.data.get('loginId', '') == ''
                    && isAdmin() && canWriteTenant(request.resource.data)
                    && singleOwnTenant(request.resource.data);

      // Update your own doc but NOT roles / tenants / personKey / loginId / loginEmail;
      // admins may update users of their own tenant only (both before and after the
      // write, so an admin cannot pull a foreign user into their tenant or push one out).
      // spec 1.77 D-R6, D-R10: an admin cannot re-point a user at another person, and
      // `diaryConsents` is written by the callable setDiaryConsent only.
      allow update: if signedIn() && loginIdentityUnchanged() && (
                       (request.auth.uid == userId
                          && !request.resource.data.diff(resource.data).affectedKeys()
                                .hasAny(['roles', 'tenants', 'personKey', 'diaryConsents']))
                       || (isAdmin() && canWriteTenant(resource.data)
                                     && callerTenants().hasAll(resource.data.tenants)
                                     && canWriteTenant(request.resource.data)
                                     && !request.resource.data.diff(resource.data).affectedKeys()
                                           .hasAny(['tenants', 'personKey', 'diaryConsents']))
                    );

      allow delete: if isAdmin() && canWriteTenant(resource.data)
                    && callerTenants().hasAll(resource.data.tenants);

      // FCM push tokens are owned by the user. (C-1 — previously any authed user
      // could read/write anyone's tokens via the catch-all.)
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // "I have looked at this" markers (SeenModel): one doc per parent key, e.g.
      // seen/calevent.<okey> — the unseen-activity badge on events. Owned by the user.
      match /seen/{parentKey} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Server badge ledger (spec 1.127 §3.7): badge/counts holds the parts of the app-icon
      // badge. Owned by the user; Cloud Functions write it with the admin SDK.
      // The values reach aps.badge unchecked, so a write must be the exact shape the server reads.
      match /badge/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && docId == 'counts' && validBadgeLedger(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == userId && docId == 'counts';
      }
    }

    // Geheime ICS-Abo-Tokens. Bewusst NICHT auf dem users-Dokument: dieses darf jeder
    // isPrivileged()-Benutzer lesen (siehe oben), und ein lesbares Bearer-Token ist kein
    // Token. Ausschliesslich über das Admin SDK erreichbar.
    match /calendarFeeds/{token} {
      allow read, write: if false;
    }

    // Server-only failure counters for the Benutzername login (spec 1.71 §5.1, plan D1).
    match /login-throttle/{id} {
      allow read, write: if false;
    }

    // Server-only WebAuthn credentials (passkeys), accessed via Cloud Functions (spec 1.120).
    match /passkeys/{id} {
      allow read, write: if false;
    }

    // Server-only one-time WebAuthn challenges (spec 1.120).
    match /webauthn-challenges/{id} {
      allow read, write: if false;
    }

    // ============================================================================
    //  Tenant-scoped, client-writable collections.
    //  Phase 1: any authenticated member of the document's tenant. Per-collection
    //  role tightening (memberAdmin for persons, treasurer for accounting, …) is
    //  Phase 2.
    // ============================================================================

    match /accounting-configs/{id} { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /accounts/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // Kostenstellen (spec 1.65 §8.3): treasurer/admin only; archive instead of delete.
    // read also for privileged (spec 1.65 D26): the project page's Umlagen need the Kostenstelle tree; no personal data
    match /cost-centers/{id} { allow read: if tenantRead() && (hasRole('treasurer') || hasRole('privileged') || isAdmin()); allow create, update: if (hasRole('treasurer') || isAdmin()) && tenantCreateOrDetach(); allow delete: if false; }

    // Budgets (spec 1.65 §8.3): treasurer/admin only. approved → only superseded; superseded frozen.
    // A budget line may be written only while its version is a draft (getAfter: a copy creates the
    // version and its first lines in one batch).
    function isTreasurerOrAdmin() { return hasRole('treasurer') || isAdmin(); }
    match /budget-versions/{id} {
      allow read: if tenantRead() && isTreasurerOrAdmin();
      allow create: if isTreasurerOrAdmin() && tenantCreateOrDetach() && request.resource.data.status == 'draft';
      // update: tenantUpdate() also checks the OLD tenants, so another tenant's treasurer cannot rewrite them.
      allow update: if isTreasurerOrAdmin() && tenantUpdate() && (
        (resource.data.status == 'draft' && resource.data.get('isArchived', false) == false)
        || (resource.data.status == 'approved' && request.resource.data.status == 'superseded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if false;
    }
    // Umlagen (spec 1.65 D24): report-level allocation rules — treasurer/admin; archived, never deleted.
    match /cost-allocations/{id} {
      // read also for privileged (D26): every viewer of the project page sees the same result; writes stay treasurer/admin
      allow read: if tenantRead() && (isTreasurerOrAdmin() || hasRole('privileged'));
      allow create: if isTreasurerOrAdmin() && tenantCreateOrDetach();
      allow update: if isTreasurerOrAdmin() && tenantUpdate();
      allow delete: if false;
    }
    match /budget-lines/{id} {
      allow read: if tenantRead() && isTreasurerOrAdmin();
      allow create: if isTreasurerOrAdmin() && tenantCreateOrDetach()
        && getAfter(/databases/$(database)/documents/budget-versions/$(request.resource.data.versionKey)).data.status == 'draft'
        && getAfter(/databases/$(database)/documents/budget-versions/$(request.resource.data.versionKey)).data.get('isArchived', false) == false;
      // update: a cell cannot move between versions, and its (current) version must be a live draft.
      allow update: if isTreasurerOrAdmin() && tenantUpdate()
        && request.resource.data.versionKey == resource.data.versionKey
        && get(/databases/$(database)/documents/budget-versions/$(resource.data.versionKey)).data.status == 'draft'
        && get(/databases/$(database)/documents/budget-versions/$(resource.data.versionKey)).data.get('isArchived', false) == false;
      allow delete: if isTreasurerOrAdmin() && tenantDelete()
        && get(/databases/$(database)/documents/budget-versions/$(resource.data.versionKey)).data.status == 'draft'
        && get(/databases/$(database)/documents/budget-versions/$(resource.data.versionKey)).data.get('isArchived', false) == false;
    }
    // Activities are the audit log. Authenticated tenant members write normal activities.
    // Auth-scope events (login/logout) are logged by ActivityService.logAuth pre-auth or
    // during the post-signIn token-propagation race, i.e. with request.auth == null. Allow
    // that ONE shape-constrained anonymous create (empty author.key, single tenant) so failed
    // and racing logins still land in the audit trail — mirrors the sessions anonymous create.
    match /activities/{id} {
      allow read:   if tenantRead();
      allow create: if tenantCreate()
                     || (request.resource.data.scope == 'auth'
                          && request.resource.data.author.key == ''
                          && request.resource.data.tenants.size() == 1);
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }
    // addresses = PII vault (spec 1.19 Phase 4 lock): raw read only for the owner,
    // privileged, or memberAdmin (D-P4-1 as amended); plain members read the
    // address-directory projection or the getAddressView callable. Sensitive
    // channels (ssn/dob/bankaccount) are writable only by owner/privileged/memberAdmin.
    match /addresses/{id} {
      // resource == null: a get() on a missing doc — allow the clean not-found
      // (same rationale as tenantRead(); list results always have a concrete resource).
      allow read:   if userExists() && (resource == null || canReadVault(resource.data));
      allow create: if tenantCreate()
                     && (!isSensitiveChannel(request.resource.data) || canWriteSensitive(request.resource.data));
      allow update: if tenantUpdate()
                     && (!(isSensitiveChannel(resource.data) || isSensitiveChannel(request.resource.data))
                         || canWriteSensitive(resource.data));
      allow delete: if tenantDelete()
                     && (!isSensitiveChannel(resource.data) || canWriteSensitive(resource.data));
    }
    // Person avatars follow the person, not the uploading tenant. Persons are shared
    // across tenants (persons/kaiser lives in 6) but newAvatarModel stamps the avatar
    // doc with the single tenant that uploaded it, so every OTHER tenant hit "Missing
    // or insufficient permissions" on avatars/person.<key> — read and re-upload alike.
    // The doc carries only a storagePath and the bytes are served unsigned from imgix,
    // so cross-tenant access leaks nothing; canWriteAvatar still limits writes to the
    // subject, privileged or memberAdmin. Non-person avatars (org, resource, section, …)
    // stay ordinary tenant content.
    // Read is NOT id-conditional: AvatarService streams the whole collection
    // (tenants array-contains <tenant>, person + org + resource docs mixed), and a rule
    // whose outcome depends on {id} is not provable for a list query — Firestore denied
    // the whole stream, so every avatar in every app fell back to the default icon.
    // A plain `userExists()` read is the same exposure the person case already accepted:
    // the doc carries only a storagePath and the bytes are served unsigned from imgix.
    match /avatars/{id}            { allow read: if userExists(); allow create, update: if (isPersonAvatar(id) ? userExists() : tenantCreateOrDetach()) && canWriteAvatar(id); allow delete: if (isPersonAvatar(id) ? userExists() : tenantDelete()) && canWriteAvatar(id); }
    // Bootseinteilung target counts — document id IS the tenantId (like app-config).
    match /boat-targets/{id}       { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /calendars/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // ── training courses on calevents (spec 1.132 §6.1) ─────────────────────────────
    // calevents stay tenant-wide (tenantCreateOrDetach) for everything but the course fields:
    // the attendance record (attendance, attendanceConfirmedBy, attendanceConfirmedAt) and the
    // course assignment (courseKey) are written only by a course editor of a course that is not
    // locked. A frozen course (`isLocked`) blocks both for everybody, privileged included, until a
    // responsible unlocks it. An empty key is never handed to get()/exists(), and a key containing
    // '/' is refused before it can address another document.
    function coursePath(courseKey) {
      return /databases/$(database)/documents/courses/$(courseKey);
    }
    function isDocKey(key) {
      return key is string && key.matches('[^/]+');
    }
    // Group admin = the caller's person key in the STORED, server-maintained groups/{key}.adminKeys
    // (the mirror the groups block reads; a client never writes it), of a group in the caller's own
    // tenant: persons are shared across tenants, so without the tenant check the admin of a group that
    // lives only in tenant X would manage a tenant-Y course pointing at that group.
    // The helpers below hand fetched data and the caller's person key down as arguments instead of
    // re-calling get()/callerPersonKey(): a courseKey move checks two courses and two groups, and the
    // re-evaluating form hit the 1000-expression limit of a rules evaluation (denied, not slow).
    function isAdminOfGroup(groupKey) {
      return isDocKey(groupKey) && isAdminOfGroupAt(/databases/$(database)/documents/groups/$(groupKey), callerPersonKey());
    }
    function isAdminOfGroupAt(path, pk) {
      return pk != '' && exists(path) && isAdminOfGroupData(get(path).data, pk);
    }
    function isAdminOfGroupData(group, pk) {
      return group.tenants.hasAny(callerTenants()) && pk in group.get('adminKeys', []);
    }
    // responsibleKeys / trainerKeys are server-maintained mirrors of responsiblePersons[] / trainers[]
    // (course trigger), so a client cannot make itself responsible or trainer by editing the arrays.
    function isCourseResponsible(course) {
      return isPersonIn(callerPersonKey(), course.get('responsibleKeys', []));
    }
    function isPersonIn(pk, keys) {
      return pk != '' && pk in keys;
    }
    // Course editor (attendance + assigning events, spec §6 table) of the course DATA: privileged,
    // eventAdmin, a trainer or a responsible of the course, or an admin of the course's group.
    function isCourseEditor(course) {
      return isPrivileged() || hasRole('eventAdmin')
        || isCourseStaff(course, callerPersonKey())
        || isAdminOfGroup(course.get('groupKey', ''));
    }
    function isCourseStaff(course, pk) {
      return pk != '' && (pk in course.get('trainerKeys', []) || pk in course.get('responsibleKeys', []));
    }
    // A course write on a calevent: the course exists, belongs to the caller's tenant, is not locked,
    // and the caller is a course editor.
    function courseEventWriteOk(courseKey) {
      return isDocKey(courseKey) && exists(coursePath(courseKey))
        && courseDataWriteOk(get(coursePath(courseKey)).data);
    }
    function courseDataWriteOk(course) {
      return course.tenants.hasAny(callerTenants())
        && course.get('isLocked', false) != true
        && isCourseEditor(course);
    }
    // An absent courseKey (legacy event) equals '': a series edit writing courseKey '' to a legacy
    // sibling is no course change and needs no course rights.
    function caleventCourseKey(data) {
      return data.get('courseKey', '');
    }
    function courseAttendanceChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['attendance', 'attendanceConfirmedBy', 'attendanceConfirmedAt']);
    }
    function courseKeyChange() {
      return caleventCourseKey(request.resource.data) != caleventCourseKey(resource.data);
    }
    // Archiving / restoring a course event (and deleting it, below) is assignment too: a locked course
    // freezes its events for everybody, and a plain member cannot drop a reported training. Events
    // without a course stay exactly as before.
    function storedCourseEventWriteOk() {
      return caleventCourseKey(resource.data) == '' || courseEventWriteOk(caleventCourseKey(resource.data));
    }
    // Cancelling a course event (state to 'cancelled') or taking the cancellation back drops / restores a
    // training like archiving does, so it counts as an archive change.
    function caleventCancelChange() {
      return (request.resource.data.get('state', '') == 'cancelled') != (resource.data.get('state', '') == 'cancelled');
    }
    // update: attendance needs a non-empty STORED course; attendance, archive (incl. cancel) and a courseKey
    // change need course rights on the stored course (if any); a courseKey change also on the new one (if any).
    // Each course is checked at most once.
    function caleventCourseUpdateOk() {
      return caleventCourseUpdateOkFor(caleventCourseKey(resource.data), caleventCourseKey(request.resource.data),
        courseAttendanceChange(), courseKeyChange(),
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['isArchived']) || caleventCancelChange());
    }
    function caleventCourseUpdateOkFor(oldKey, newKey, attendanceChange, keyChange, archiveChange) {
      return (!attendanceChange || oldKey != '')
        && (oldKey == '' || !(attendanceChange || keyChange || archiveChange) || courseEventWriteOk(oldKey))
        && (!keyChange || newKey == '' || courseEventWriteOk(newKey));
    }
    // create: resetAttendance() sends attendance {} and attendanceConfirmedAt '' (attendanceConfirmedBy
    // undefined = absent) — always fine. Attendance is never created pre-filled; a non-empty courseKey
    // (a trainer adding a series to the course) needs a course editor of an unlocked course.
    function caleventCourseCreateOk() {
      return request.resource.data.get('attendance', {}) == {}
        && request.resource.data.get('attendanceConfirmedBy', null) == null
        && request.resource.data.get('attendanceConfirmedAt', '') == ''
        && (caleventCourseKey(request.resource.data) == ''
            || courseEventWriteOk(caleventCourseKey(request.resource.data)));
    }
    match /calevents/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && caleventCourseCreateOk();
      allow update: if tenantCreateOrDetach() && caleventCourseUpdateOk();
      allow delete: if tenantDelete() && storedCourseEventWriteOk();
    }
    match /comments/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // diaries + diaryImports (diary-import feature, 2026-08): a diary entry/run is authored by
    // exactly ONE person, identified by their Firebase Auth uid on `authorKey` — NOT their
    // personKey, unlike `docs.authorKey` above. `apps/functions/src/privacy/subject-data-map.ts`
    // (the "diaries"/"diaryImports" rows) resolves the export/erasure subject the same way —
    // `authorKey == request.auth.uid`, for read and for write alike — and its comment there
    // states that is "what the collection's rule compares against". These two match blocks are
    // what makes that premise true; keep both in sync if either side changes. Nobody but the
    // author may ever read or write their own diary, admin included — a private diary has no
    // "moderator" role the way CMS content or docs do.
    //
    // READ is owner-only WITHOUT a tenant clause (spec 1.114 §3): the album queries filter on
    // `authorKey ==` + `albumKeys array-contains` and cannot also carry `tenants array-contains`,
    // so a rule that demanded the tenant would refuse them as unprovable. The client drops other
    // tenants' entries after the read; WRITES keep the tenant checks. `diaryAlbums` is the same.
    function isDiaryOwner(data) {
      return userExists() && data.authorKey == request.auth.uid;
    }
    match /diaries/{id} {
      allow read: if userExists() && (resource == null || isDiaryOwner(resource.data));
      allow create: if userExists() && isDiaryOwner(request.resource.data) && canWriteTenant(request.resource.data);
      allow update: if userExists() && isDiaryOwner(resource.data) && isDiaryOwner(request.resource.data)
                      && belongsToTenant(resource.data) && belongsToTenant(request.resource.data);
      allow delete: if userExists() && isDiaryOwner(resource.data) && canWriteTenant(resource.data);
    }
    // A non-existent album may be read (createModel's existence check, the archived-album
    // lookup) only under the caller's OWN id — `<tenant>__<uid>__<kind>__<ref>` — so nobody can
    // probe which albums another author has.
    match /diaryAlbums/{id} {
      allow read: if userExists() && ((resource == null && id.matches('^[^_]+__' + request.auth.uid + '__.*'))
                      || isDiaryOwner(resource.data));
      allow create: if userExists() && isDiaryOwner(request.resource.data) && canWriteTenant(request.resource.data);
      allow update: if userExists() && isDiaryOwner(resource.data) && isDiaryOwner(request.resource.data)
                      && belongsToTenant(resource.data) && belongsToTenant(request.resource.data);
      allow delete: if userExists() && isDiaryOwner(resource.data) && canWriteTenant(resource.data);
    }
    // Hörtraining (spec 2026-09-28-hearing-quiz-spec.md). The content tree is authored in the
    // app by content admins and read by every member of the tenant.
    match /hearingQuizNodes/{id} {
      allow read: if tenantRead();
      allow create, update: if isContentManager() && tenantCreateOrDetach();
      allow delete: if isContentManager() && canWriteTenant(resource.data);
    }
    // Kreuzworträtsel (spec 2026-09-29-crossword-spec.md). Topics are authored in the app by
    // content admins and read by every member of the tenant, mirroring hearingQuizNodes.
    match /crosswordTopics/{id} {
      allow read: if tenantRead();
      allow create, update: if isContentManager() && tenantCreateOrDetach();
      allow delete: if isContentManager() && canWriteTenant(resource.data);
    }
    // Training results are HEALTH DATA (revDSG Art. 5 lit. c): readable and writable by the one
    // user they belong to — `userKey` is the Firebase Auth uid — and by nobody else, admin
    // included, like `diaries`. HearingQuizResultService.listMine mirrors this rule in its query
    // (uid AND tenant), which is what lets Firestore prove the rule for a list; keep both in step.
    function isResultOwner(data) {
      return userExists() && data.userKey == request.auth.uid;
    }
    match /hearingQuizResults/{id} {
      allow read: if userExists() && (resource == null || (isResultOwner(resource.data) && belongsToTenant(resource.data)));
      allow create: if isResultOwner(request.resource.data) && canWriteTenant(request.resource.data);
      allow update: if isResultOwner(resource.data) && isResultOwner(request.resource.data)
                      && belongsToTenant(resource.data) && canWriteTenant(request.resource.data);
      allow delete: if isResultOwner(resource.data) && canWriteTenant(resource.data);
    }
    // chatReminders (spec 1.104): one doc per «remind me» on a bookmarked chat message. Owner-only.
    // Created pending by the client; the owner may only snooze (dueAt, while pending) or cancel.
    // The 5-minute sweep sets `sent` via the Admin SDK, which bypasses these rules. No delete.
    match /chatReminders/{id} {
      allow read: if userExists() && (resource == null || (belongsToTenant(resource.data)
                      && resource.data.personKey == callerPersonKey()));
      // Exact keys (createModel strips okey): in particular no `failures`, the sweep's retry
      // counter — a client-seeded negative count would keep a broken doc in the sweep forever.
      allow create: if canWriteTenant(request.resource.data)
                      && request.resource.data.keys().hasOnly(['tenants', 'personKey', 'dueAt', 'state',
                           'notesRoomId', 'bookmarkEventId', 'roomId', 'eventId', 'title'])
                      && callerPersonKey() != ''
                      && request.resource.data.personKey == callerPersonKey()
                      && request.resource.data.state == 'pending'
                      && request.resource.data.dueAt is int
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200;
      allow update: if belongsToTenant(resource.data)
                      && resource.data.personKey == callerPersonKey()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueAt', 'state'])
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dueAt'])
                          || (resource.data.state == 'pending' && request.resource.data.dueAt is int))
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['state']) || request.resource.data.state == 'cancelled');
      allow delete: if false;
    }
    // spec 1.77 §12.2: what one owner's diary collects from their other apps. Owner-only like `diaries`, never a
    // field on `users`, which a tenant admin may edit (D-R1). Document id = the owner's uid; the functions read it
    // with the Admin SDK.
    match /diarySources/{uid} {
      allow read: if userExists() && (resource == null || isDiaryOwner(resource.data));
      allow create: if userExists() && uid == request.auth.uid
                      && isDiaryOwner(request.resource.data) && canWriteTenant(request.resource.data);
      allow update: if userExists() && uid == request.auth.uid
                      && isDiaryOwner(resource.data) && isDiaryOwner(request.resource.data)
                      && belongsToTenant(resource.data) && belongsToTenant(request.resource.data);
      allow delete: if userExists() && isDiaryOwner(resource.data) && canWriteTenant(resource.data);
    }
    match /diaryImports/{id} {
      allow read: if userExists() && (resource == null || (isDiaryOwner(resource.data) && belongsToTenant(resource.data)));
      // Written only by dryRunDiaryImport/commitDiaryImport via the Admin SDK, which bypasses
      // these rules entirely — no client write path exists.
      allow write: if false;
    }
    // docs + folders (spec 1.22 — event image folders):
    // members may create docs only into a membersMayUpload folder, as themselves;
    // authors manage their own docs; the folder owner may moderate (delete/update) docs in their folder.
    match /docs/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && (
        isContentManager()
        || (callerPersonKey() != ''
            && request.resource.data.get('authorKey', '') == callerPersonKey()
            && request.resource.data.get('folderKeys', []).size() == 1
            && belongsToTenant(folderData(request.resource.data.folderKeys[0]))
            && folderData(request.resource.data.folderKeys[0]).get('membersMayUpload', false) == true
            && !inLearningRoom(request.resource.data.folderKeys)));
      // ratingCount/ratingSum are the onRatingWritten aggregate (Admin SDK, bypasses rules): no client
      // path but an admin's may change them (spec 1.115 §7.2). DocumentService.update never sends them.
      allow update: if tenantUpdate()
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingCount', 'ratingSum']))
        && (
        isContentManager()
        || (callerPersonKey() != ''
            && !inLearningRoom(resource.data.get('folderKeys', []))
            && resource.data.get('authorKey', '') == callerPersonKey()
            && request.resource.data.get('authorKey', '') == resource.data.get('authorKey', '')
            && request.resource.data.get('folderKeys', []) == resource.data.get('folderKeys', []))
        || (callerPersonKey() != ''
            && resource.data.get('folderKeys', []).size() > 0
            && !inLearningRoom(resource.data.folderKeys)
            && belongsToTenant(folderData(resource.data.folderKeys[0]))
            && folderData(resource.data.folderKeys[0]).get('ownerKey', '') == callerPersonKey()
            && request.resource.data.get('authorKey', '') == resource.data.get('authorKey', '')
            && request.resource.data.get('folderKeys', []) == resource.data.get('folderKeys', [])));
      allow delete: if tenantDelete() && (
        isAdmin()
        || (callerPersonKey() != ''
            && !inLearningRoom(resource.data.get('folderKeys', []))
            && resource.data.get('authorKey', '') == callerPersonKey())
        || (callerPersonKey() != ''
            && resource.data.get('folderKeys', []).size() > 0
            && !inLearningRoom(resource.data.folderKeys)
            && belongsToTenant(folderData(resource.data.folderKeys[0]))
            && folderData(resource.data.folderKeys[0]).get('ownerKey', '') == callerPersonKey()));
    }
    // travel journal (spec 1.113 plan 4). Devices only APPEND change records; the applyJournalChange
    // function materialises them under journals/{jk} with the Admin SDK. Authors are the person keys in
    // journals/{jk}.authorKeys (written by the function from the records). Guests come with plan 6.
    function isJournalAuthor(jk) {
      return callerPersonKey() != ''
        && exists(/databases/$(database)/documents/journals/$(jk))
        && callerPersonKey() in get(/databases/$(database)/documents/journals/$(jk)).data.get('authorKeys', []);
    }
    match /journal-changes/{id} {
      allow read: if userExists() && isJournalAuthor(resource.data.journalKey);
      // A new journal's first record creates it: only its own 'journal' create, before the
      // function has written journals/{jk}. Every other record needs the caller to be an author.
      allow create: if tenantCreate()
        && callerPersonKey() != ''
        && request.resource.data.get('id', '') == id
        && request.resource.data.get('uploadedAt', null) == request.time
        && request.resource.data.get('journalKey', '').matches('[A-Za-z0-9_-]{1,128}')
        // any author's device uploads records of every author (records reach it over P2P, plan 5)
        && ((isJournalAuthor(request.resource.data.journalKey)
             && request.resource.data.get('authorKey', '') in get(/databases/$(database)/documents/journals/$(request.resource.data.journalKey)).data.get('authorKeys', []))
            || (request.resource.data.get('authorKey', '') == callerPersonKey()
                && !exists(/databases/$(database)/documents/journals/$(request.resource.data.journalKey))
                && request.resource.data.get('entity', '') == 'journal'
                && request.resource.data.get('op', '') == 'create'
                && request.resource.data.get('entityKey', '') == request.resource.data.journalKey));
      allow update, delete: if false;
    }
    // Ephemeral edit locks (spec 1.126 §6.2): doc id journalKey_entityKey, any author may clear a stale one.
    match /journal-locks/{id} {
      allow read: if userExists() && isJournalAuthor(resource.data.journalKey);
      allow create: if tenantCreate()
        && callerPersonKey() != ''
        && isJournalAuthor(request.resource.data.get('journalKey', ''))
        && request.resource.data.get('personKey', '') == callerPersonKey()
        && request.resource.data.get('entityKey', null) is string
        && request.resource.data.get('name', null) is string
        && request.resource.data.name.size() < 200
        && request.resource.data.get('until', null) is timestamp
        && request.resource.data.until < request.time + duration.value(5, 'm')
        && id == request.resource.data.get('journalKey', '') + '_' + request.resource.data.get('entityKey', '');
      allow update: if tenantCreate()
        && callerPersonKey() != ''
        && isJournalAuthor(resource.data.journalKey)
        && request.resource.data.get('journalKey', '') == resource.data.journalKey
        && request.resource.data.get('personKey', '') == callerPersonKey()
        && request.resource.data.get('entityKey', null) is string
        && request.resource.data.get('name', null) is string
        && request.resource.data.name.size() < 200
        && request.resource.data.get('until', null) is timestamp
        && request.resource.data.until < request.time + duration.value(5, 'm')
        && id == request.resource.data.get('journalKey', '') + '_' + request.resource.data.get('entityKey', '');
      allow delete: if userExists() && isJournalAuthor(resource.data.journalKey);
    }
    match /journals/{jk} {
      allow read: if userExists() && resource != null && callerPersonKey() != ''
        && callerPersonKey() in resource.data.get('authorKeys', []);
      allow write: if false;
      match /{sub}/{docId} {
        allow read: if userExists() && sub in ['footprints', 'sections', 'images'] && isJournalAuthor(jk);
        allow write: if false; // private/{peer,guestLinks}: callables only
      }
    }
    // travel book of a journal (spec 1.113 phase 2 §6): journal-books/{jk}, one per journal, authors only.
    // `export` is written by the exportJournalBook function (Admin SDK) alone; `prints` is client-writable
    // (the iPad records its uploaded print photos). Tenants must equal the journal's.
    match /journal-books/{jk} {
      allow read: if userExists() && isJournalAuthor(jk);
      allow create, update: if userExists() && isJournalAuthor(jk)
        && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['export'])
        && request.resource.data.tenants == get(/databases/$(database)/documents/journals/$(jk)).data.tenants;
      allow delete: if false;
    }
    // ratings (learning rooms, spec 1.115): one star rating per person and document, okey =
    // `<docKey>__<personKey>`. Author-only reads (the aggregate lives on docs, written by the
    // onRatingWritten trigger with the Admin SDK). parentKey is 'document.<docKey>'.
    match /ratings/{id} {
      allow read: if tenantRead()
        && (resource == null || resource.data.get('personKey', '') == callerPersonKey());
      allow create: if tenantCreate()
        && callerPersonKey() != ''
        && request.resource.data.get('personKey', '') == callerPersonKey()
        && request.resource.data.get('parentKey', '').matches('document\\.[^.]+')
        && request.resource.data.keys().hasOnly(['tenants', 'parentKey', 'personKey', 'stars', 'updatedAt', 'isArchived'])
        && exists(/databases/$(database)/documents/docs/$(request.resource.data.parentKey.split('\\.')[1]))
        && belongsToTenant(get(/databases/$(database)/documents/docs/$(request.resource.data.parentKey.split('\\.')[1])).data)
        && id == request.resource.data.parentKey.split('\\.')[1] + '__' + callerPersonKey()
        && request.resource.data.get('stars', 0) is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow update: if tenantUpdate()
        && callerPersonKey() != ''
        && resource.data.get('personKey', '') == callerPersonKey()
        && request.resource.data.get('personKey', '') == resource.data.get('personKey', '')
        && request.resource.data.get('parentKey', '') == resource.data.get('parentKey', '')
        && request.resource.data.keys().hasOnly(['tenants', 'parentKey', 'personKey', 'stars', 'updatedAt', 'isArchived'])
        && request.resource.data.get('stars', 0) is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if tenantDelete()
        && callerPersonKey() != ''
        && resource.data.get('personKey', '') == callerPersonKey();
    }
    // learningRoom (spec 1.115 §7.2): only a content admin / admin may set it on create or change it.
    match /folders/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate()
        && (request.resource.data.get('learningRoom', false) != true || isContentAdminOrAdmin())
        && (
        isContentManager()
        || (callerPersonKey() != '' && request.resource.data.get('ownerKey', '') == callerPersonKey()));
      allow update: if tenantUpdate()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['learningRoom']) || isContentAdminOrAdmin())
        && (
        isContentManager()
        || (callerPersonKey() != '' && resource.data.get('ownerKey', '') == callerPersonKey()));
      // a room folder is deletable only by contentAdmin/admin: delete + recreate unflagged would reopen
      // author/owner writes on all room files
      allow delete: if tenantDelete()
        && (resource.data.get('learningRoom', false) != true || isContentAdminOrAdmin())
        && (
        isContentManager()
        || (callerPersonKey() != '' && resource.data.get('ownerKey', '') == callerPersonKey()));
    }
    // courses (spec 1.132 §6.1): read tenant-wide; created and changed by privileged, a responsible
    // (STORED responsibleKeys) or an admin of the course group. On create the mirrors are empty, so a
    // creator is privileged or group admin. trainerKeys/responsibleKeys are written only by the course
    // trigger (Admin SDK); CourseService strips them. Moving a course to another group needs admin of
    // the target group (or privileged). Courses are archived, never deleted.
    match /courses/{id} {
      function courseFinanceOk(course) {
        return course.tenants.hasAny(callerTenants())
          && (isPrivileged() || hasRole('treasurer') || isCourseManager(course));
      }
      function courseFinanceWriteOk(course) {
        return course.tenants.hasAny(callerTenants()) && isCourseManager(course);
      }
      function isCourseManager(course) {
        return isPrivileged() || isCourseResponsible(course) || isAdminOfGroup(course.get('groupKey', ''));
      }
      allow read: if tenantRead();
      allow create: if tenantCreate()
        && isCourseManager(request.resource.data)
        && request.resource.data.get('trainerKeys', []) == []
        && request.resource.data.get('responsibleKeys', []) == [];
      allow update: if tenantUpdate()
        && isCourseManager(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trainerKeys', 'responsibleKeys'])
        && (request.resource.data.get('groupKey', '') == resource.data.get('groupKey', '')
            || isPrivileged() || isAdminOfGroup(request.resource.data.get('groupKey', '')));
      allow delete: if false;
      // courses/{id}/finance/settings: the amounts — Firestore cannot hide fields, hence a subdoc.
      // Read: responsible, group admin, treasurer, privileged. Write: responsible, group admin, privileged —
      // the treasurer sees the rates but does not set them (spec §6). Tenant taken from the parent course.
      match /finance/{doc} {
        allow read: if userExists() && exists(coursePath(id)) && courseFinanceOk(get(coursePath(id)).data);
        allow write: if userExists() && exists(coursePath(id)) && courseFinanceWriteOk(get(coursePath(id)).data);
      }
    }
    // groups (spec 1.115 §7.2): created by privileged/memberAdmin only; changed, archived, detached
    // or deleted by those roles OR by an admin of THIS group. Group admins are matched against
    // `adminKeys`, the exact `admins[].key` mirror that only the adminKeys handler of the
    // onGroupDocWritten trigger (Admin SDK) maintains — a client can never write it, so a plain
    // member cannot make itself admin by adding itself to `admins[]` (the check reads the STORED
    // adminKeys, not the incoming doc).
    // A group admin who removes itself from admins[] still passes (stored adminKeys) and loses
    // the right once the trigger has rewritten adminKeys. Client writers strip adminKeys
    // (stripAdminKeys, @okr/subject-group-util) so an updateDoc never touches the field.
    match /groups/{id} {
      function isGroupManager() {
        return isPrivileged() || hasRole('memberAdmin')
          || (callerPersonKey() != '' && callerPersonKey() in resource.data.get('adminKeys', []));
      }
      allow read: if tenantRead();
      allow create: if tenantCreate()
        && (isPrivileged() || hasRole('memberAdmin'))
        && request.resource.data.get('adminKeys', []) == [];
      allow update: if tenantUpdate()
        && isGroupManager()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminKeys']);
      allow delete: if tenantDelete() && isGroupManager();
    }
    match /i18nTenantOverride/{id} { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /icons/{id}              { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // An invitation belongs to one tenant and one event for life. `caleventKey` names the event the
    // Cloud Functions read and write with the Admin SDK, and the signed answer link stays valid after
    // issue, so a second tenant on the doc (or a self-detach down to the foreign one) or a repointed
    // key would reach another tenant's event. Hence one tenant on create, and no change to either
    // field afterwards. An invitation is never shared, so there is nothing to detach.
    match /invitations/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && request.resource.data.tenants.size() == 1;
      allow update: if tenantUpdate()
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenants', 'caleventKey']);
      allow delete: if tenantDelete();
    }
    match /locations/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // weather: written ONLY by the scheduled Cloud Function, which uses the Admin SDK and
    // bypasses these rules. No client may write — a forged forecast is not worth the attack
    // surface, and nothing in the app has a reason to.
    match /weather/{id}            { allow read: if tenantRead(); allow write: if false; }
    // weather-radar: the MeteoSwiss radar frame list (spec 1.110), written only by the scheduled
    // `fetchMeteoSwissRadar`. One document shared by every tenant (O5) holding nothing but image
    // paths of open government data, so it is readable without sign-in — the rain_radar widget
    // also renders on public pages, as it did with RainViewer.
    match /weather-radar/{id}      { allow read: if true; allow write: if false; }
    // energy-figures: municipal energy figures and tariffs (spec 1.136), one document per BFS
    // number, written ONLY by the scheduled job (Admin SDK). `tenants` is the union of the tenants
    // with a city location for that municipality, so tenantRead() lets exactly those read it.
    match /energy-figures/{id}     { allow read: if tenantRead(); allow write: if false; }
    match /memberships/{id}        { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /ownerships/{id}         { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /personal-rels/{id}      { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // persons: resurrection guard (spec 1.19 Phase 4) — the stripped PII fields
    // (ssnId/dateOfBirth/dateOfDeath/favEmail/favPhone) must never reappear on the doc.
    // dateOfDeath moved to the 'dod' vault channel; persons keep only the isDeceased flag.
    match /persons/{id} {
      allow read:   if tenantRead();  // C-2: no longer public
      allow create: if tenantCreate()
                     && !request.resource.data.keys().hasAny(['ssnId', 'dateOfBirth', 'dateOfDeath', 'favEmail', 'favPhone'])
                     && indexHasNoSensitivePii();
      allow update: if tenantUpdate()
                     && !request.resource.data.keys().hasAny(['ssnId', 'dateOfBirth', 'dateOfDeath', 'favEmail', 'favPhone'])
                     && indexHasNoSensitivePii();
      allow delete: if tenantDelete();
    }
    // Meetings (spec 2.7). Group scoping is enforced in MeetingStore.visibleMeetings, NOT
    // here: a rules-level group check costs a get() per document read. A tenant member with
    // API access can therefore read another group's minutes — recorded ceiling, not an
    // oversight. Tightening this is the upgrade path named in the spec.
    match /meetings/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // damages and locks (reason maintenance/blocked/damage) are the Schadensliste's history:
    // they are ended, never deleted — keep the list in sync with DAMAGE_REASONS (reservation-util).
    // Their reason is frozen too: re-classing one (e.g. to 'course') would make it deletable.
    match /reservations/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreateOrDetach();
      allow update: if tenantCreateOrDetach()
        && !(resource.data.get('reason', '') in ['maintenance', 'blocked', 'damage']
             && request.resource.data.get('reason', '') != resource.data.get('reason', ''));
      allow delete: if tenantDelete() && !(resource.data.get('reason', '') in ['maintenance', 'blocked', 'damage']);
    }
    match /member-fees/{id}        { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // Pre-rename home of the member-fee rows; the retired migrateMemberFees migration copied
    // them id-for-id and left the originals in place, so they stay readable/erasable until the
    // owner drops the collection.
    match /scs-memberfees/{id}     { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // tasks (spec 1.72 §2, §3.1, §4): readable/writable by author, assignee and staff
    // (privileged/eventAdmin); shared tasks (shareKey = group key or 'meeting.<okey>') are
    // tenant-readable. Archiving (isArchived -> true, or a self-detach) is author/privileged only.
    // Group admins get no extra writes (§4, decided 2026-09-30). Only privileged may change
    // the author.
    // author/assignee may be absent on legacy docs, hence get(…, {}).
    // A caller without a personKey ('' from callerPersonKey()) must never match a missing field.
    function taskAuthor(data) {
      return callerPersonKey() != '' && data.get('author', {}).get('key', '') == callerPersonKey();
    }
    function taskMember(data) {
      return taskAuthor(data)
             || (callerPersonKey() != '' && data.get('assignee', {}).get('key', '') == callerPersonKey());
    }
    // spec 1.75: a shared task is tenant-readable unless its shareKey names a closed group
    // (chatMode 'members'); those are read through the listGroupTasks callable. Meeting keys
    // and keys that name no group keep the spec 1.72 behaviour.
    function taskShareOpen(data) {
      let k = data.get('shareKey', '');
      return k != '' && (k.matches('^meeting[.].*')
        || !exists(/databases/$(database)/documents/groups/$(k))
        || get(/databases/$(database)/documents/groups/$(k)).data.get('chatMode', 'shared') != 'members');
    }
    function taskStaff() {
      return isPrivileged() || hasRole('eventAdmin');
    }
    // only privileged may change a task's author (a member/assignee must not take it over);
    // compares the key only, so a refreshed avatar name/label does not trip it
    function taskAuthorKept() {
      return request.resource.data.get('author', {}).get('key', '')
             == resource.data.get('author', {}).get('key', '');
    }
    function taskArchiving() {
      return request.resource.data.get('isArchived', false) == true
             && resource.data.get('isArchived', false) == false;
    }
    // Spec 1.72 — do NOT deploy these rules before the 1.72 rollout: run
    // scripts/backfill-task-share-key.mjs and scripts/repair-task-authors.mjs, ship the client
    // release, then deploy rules last (plan Task 9).
    match /tasks/{id} {
      allow read: if tenantRead() && (resource == null
        || taskStaff() || taskMember(resource.data) || taskShareOpen(resource.data));
      // only privileged may create a task in someone else's name (spec §2)
      // spec 1.105: no client may create an exit-* id (predictable settlement task id exit-<tenantId>-<membershipKey>); Admin SDK only
      // spec 1.132: the same for the course tasks course-<courseKey>-end / course-<courseKey>-compensation
      allow create: if tenantCreate() && !id.matches('exit-.*')
        && !id.matches('course-.*-end') && !id.matches('course-.*-compensation')
        && (isPrivileged() || taskAuthor(request.resource.data));
      // tenantUpdate(): the caller's tenant must be on the stored doc, not just on the new one
      allow update: if tenantUpdate() && (isPrivileged() || taskAuthorKept()) && (
        (taskArchiving() || selfDetach())
          ? (isPrivileged() || taskAuthor(resource.data))
          : (taskStaff() || taskMember(resource.data)));
      allow delete: if tenantDelete() && isPrivileged();
    }
    // spec 3.14 R2: project names are tenant-readable (task and booking pickers); only staff
    // create or change projects. Tasks keep their own rules — a project grants no task access.
    match /projects/{id} {
      allow read: if tenantRead();
      allow create, update: if tenantCreateOrDetach() && isPrivileged();
      allow delete: if tenantDelete() && isPrivileged();
    }
    match /transfers/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    // resource == null: a get() of a missing trip must not dereference resource.data (see tenantRead).
    match /trips/{tripId} {
      allow get:    if tenantRead() && (resource == null || isTrackOwner(resource.data));
      allow list:   if tenantRead() && isListableTrip(resource.data);
      allow create: if tenantCreate() && isTrackOwner(request.resource.data);
      // A trip may not change into or out of 'tracker': a member could otherwise hide any club trip
      // as «their» tracker trip, and the stats function would then subtract its km.
      allow update: if tenantUpdate() && isTrackOwner(resource.data) && isTrackOwner(request.resource.data)
                    && (resource.data.get('type', '') == 'tracker') == (request.resource.data.get('type', '') == 'tracker');
      allow delete: if tenantDelete() && isTrackOwner(resource.data);

      // Recorded tracker points (encoded polyline per section). Only the recording person
      // (trip.track.personKey) may read or write them, like the tracker trip doc itself.
      match /track-points/{n} {
        allow read: if isTrackOwnerOf(get(/databases/$(database)/documents/trips/$(tripId)).data);
        // getAfter: a corrected re-upload deletes stale points in the batch that may also create the trip
        allow delete: if isTrackOwnerOf(getAfter(/databases/$(database)/documents/trips/$(tripId)).data);
        // getAfter: trip and points are written in one batch, so the trip may not exist yet before the commit
        allow create, update: if isTrackOwnerOf(getAfter(/databases/$(database)/documents/trips/$(tripId)).data)
                              && request.resource.data.tenants.hasAny(callerTenants());
      }
    }
    match /websiteContent/{id}     { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }
    match /workrels/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreateOrDetach(); allow delete: if tenantDelete(); }

    // Kiosk device telemetry (battery + heartbeat), document id = the kiosk user's uid.
    // A device may only write its OWN doc; any member of the tenant may read it, admins
    // may clean up a retired kiosk. Never carries PII — uid, device model, battery, time.
    match /kiosk-status/{uid} {
      allow read: if tenantRead();
      // the device writes its own telemetry; an admin may write the doc too, to set
      // `reloadAt` (the remote "reload yourself" command the kiosk listens for)
      allow create, update: if signedIn()
                            && (isAdmin() || (request.auth.uid == uid && request.resource.data.uid == uid))
                            && belongsToTenant(request.resource.data);
      allow delete: if isAdmin() && canWriteTenant(resource.data);
    }

    // ============================================================================
    //  Read-only on the client (written by Cloud Functions / bexio sync / seed).
    //  Tenant-scoped read; writes denied. If an admin UI legitimately writes one
    //  of these, switch its write to: isPrivileged() && belongsToTenant(request.resource.data)
    // ============================================================================

    // Materialized privacy projection of addresses (spec 1.19 Phase 4): built by
    // the replication CFs from the §A3 formula; contains ONLY registered-visible
    // contact data, so any tenant member may read it. Never client-writable.
    match /address-directory/{id}  { allow read: if tenantRead(); allow write: if false; }
    match /asset-movements/{id}    { allow read: if tenantRead(); allow write: if false; }
    // Kreditoren carry vendor IBANs, amounts and internal notes: treasurer/admin only (decided 2026-10-11,
    // spec 3.36). Every client reader sits behind isTreasurerGuard or the admin console; the payment_approver
    // reads the bills of a digest through the getBillsForApproval callable, never directly.
    match /bills/{id}              { allow read: if tenantRead() && (hasRole('treasurer') || isAdmin()); allow write: if false; }
    // Vouchers, invoice/reminder PDFs and comments migrated from bexio (spec 1.68). Personal data
    // (members' receipts, internal notes) — treasurer/privileged only, never client-written.
    // The files themselves are under tenant/{tid}/private/**, which only Cloud Functions reach.
    match /finance-documents/{id} { allow read: if tenantRead() && (isPrivileged() || hasRole('treasurer')); allow write: if false; }
    // finance-comments is the Verlauf of invoices and bills: bexio comments (tags 'bexio'), events written by
    // the Cloud Functions (tags 'system,<kind>') and notes the treasurer adds in the app — the only client write:
    // a create tagged 'note' on an invoice/bill, authored by the caller. Never updated or deleted (audit trail).
    match /finance-comments/{id}  {
      allow read: if tenantRead() && (isPrivileged() || hasRole('treasurer'));
      allow create: if tenantCreate() && (isPrivileged() || hasRole('treasurer'))
        && request.resource.data.tags == 'note'
        && request.resource.data.parentKey.matches('^(invoice|bill)[.].+')
        && request.resource.data.authorKey == userData().personKey
        && request.resource.data.isArchived == false;
      allow update, delete: if false;
    }
    // The ledger (spec 1.132 §16, 2026-11-02): bookings and their lines carry every amount of the books,
    // trainer compensation included — not tenant-wide reading material. Readers: treasurer/admin (the books)
    // privileged (the project result sums every line, spec 1.65 D26) and auditor (the Revisor reads the books,
    // owner decision 2026-11-02 — all periods; rules cannot pin "closed" for a list query). A plain member reads ONLY the booking
    // of their own expense (author or payee, mirrors the `expenses` rule below): an expense booking's id is the
    // expense id (OCR pipeline), so the rule looks the expense up by the booking id resp. the line's bookingKey.
    // The role check comes first, so staff list queries never pay for the get(). A member's line query must pin
    // bookingKey (ExpenseService.listBookingLines), otherwise it cannot be proven and is denied.
    // No `resource == null` leg: compensation ids are deterministic (course-<courseKey>-<personKey>), and a
    // 404-vs-403 answer would let members probe which trainers have a booking. A member GET of a missing
    // booking is therefore denied — except for their own expense, whose booking may not exist yet (404).
    function isLedgerReader() { return isTreasurerOrAdmin() || isPrivileged() || hasRole('auditor'); }
    function expenseOfCaller(e) {
      return e.tenants.hasAny(callerTenants())
        && (e.get('userId', '') == request.auth.uid
            || (callerPersonKey() != '' && e.get('payeeKey', '') == callerPersonKey()));
    }
    function isOwnExpense(expenseKey) {
      return exists(/databases/$(database)/documents/expenses/$(expenseKey))
        && expenseOfCaller(get(/databases/$(database)/documents/expenses/$(expenseKey)).data);
    }
    match /booking-lines/{id}      { allow read: if tenantRead() && (isLedgerReader() || isOwnExpense(resource.data.bookingKey)); allow write: if false; }
    match /bookings/{id}          { allow read: if tenantRead() && (isLedgerReader() || isOwnExpense(id)); allow write: if false; }
    match /exchange-rates/{id}    { allow read: if tenantRead(); allow write: if false; }
    match /expense-documents/{id} { allow read: if tenantRead(); allow write: if false; }
    // An expense carries the payee's IBAN (for 'an Mitglied' copied from that member's profile by
    // createExpense) — not tenant-wide reading material. Readers: treasurer/admin (the books), the
    // author (userId = auth uid) and the payee of a 'member' expense (payeeKey = their personKey).
    // Firestore validates a list against the QUERY: the 'my' list filters on userId resp. payeeKey
    // (ExpenseService.listForUser / listForPayee); the unfiltered 'all' list is treasurer-only.
    match /expenses/{id} {
      allow read: if tenantRead()
                   && (hasRole('treasurer') || isAdmin()
                       || resource == null
                       || resource.data.get('userId', '') == request.auth.uid
                       || (callerPersonKey() != '' && resource.data.get('payeeKey', '') == callerPersonKey()));
      allow write: if false;
    }
    match /invoice-positions/{id} { allow read: if tenantRead(); allow write: if false; }
    // An invoice names what a member owes and for what — not tenant-wide reading
    // material. Since the member-facing `my-invoice` route exists, plain members read
    // ONLY invoices addressed to them (receiver.key == their personKey); the books
    // themselves stay with treasurer/privileged. Firestore validates a list request
    // against the QUERY, so the 'my' list must carry the matching where-clause —
    // InvoiceStore adds it (an unconstrained query is denied below treasurer, which is
    // the intent). NOT tightened here: `invoice-positions` stays tenantRead — the line
    // items would need a get() on the parent invoice per row, which no list query can
    // validate. The amounts still leak there until positions carry their own receiver.
    match /invoices/{id} {
      allow read: if tenantRead()
                   && (isPrivileged() || hasRole('treasurer')
                       || resource == null
                       || resource.data.get('receiver', {}).get('key', '') == callerPersonKey());
      allow write: if false;
    }
    // Contracts (spec 1.5 §5.1). Staff path is tenant-scoped; the own-party path is
    // tenant-INDEPENDENT on purpose: the 'my' query filters partyPersonKeys (array) and Firestore
    // allows only one array filter per query, so it cannot also constrain tenants[].
    function contractStaffReader(d) {
      return isAdmin() || hasRole('treasurer')
             || ((isPrivileged() || hasRole('auditor')) && d.get('isStrictlyConfidential', true) == false);
    }
    function contractReader(d) {
      return (canWriteTenant(d) && contractStaffReader(d))
             || (callerPersonKey() != '' && callerPersonKey() in d.get('partyPersonKeys', []));
    }
    // documents[] (registerContractDocument) and remindersSent (scanner) are server-owned: a client
    // creates them empty and never changes them — a stale modal copy would otherwise wipe registered
    // files or re-arm sent reminders. The client update omits both, so updateDoc leaves them equal.
    function contractServerFieldsUnchanged() {
      return request.resource.data.get('documents', []) == resource.data.get('documents', [])
             && request.resource.data.get('remindersSent', []) == resource.data.get('remindersSent', []);
    }
    match /contracts/{id} {
      allow read: if userExists() && (resource == null || contractReader(resource.data));
      allow create: if (hasRole('treasurer') || isAdmin()) && tenantCreate()
                    && request.resource.data.get('documents', []).size() == 0
                    && request.resource.data.get('remindersSent', []).size() == 0;
      allow update: if (hasRole('treasurer') || isAdmin()) && tenantUpdate() && contractServerFieldsUnchanged();
      allow delete: if false;
    }
    match /contract-documents/{id} {
      allow read: if userExists() && (resource == null || contractReader(resource.data));
      allow write: if false;
    }
    match /journallogs/{id}       { allow read: if tenantRead(); allow write: if false; }
    // Payment orders + payments (spec 1.80 §5.4): finance data, treasurer/admin only. Clients may
    // create and edit DRAFT orders (payments: confirm only, see below); approval and transmission happen only in approvePaymentOrder /
    // generatePain001 (admin SDK), so no client can approve or self-approve.
    function isTreasurer() { return hasRole('treasurer') || isAdmin(); }
    function staysDraft() {
      return request.resource.data.status == 'draft' && request.resource.data.get('approvedBy', '') == '';
    }
    function orderIsDraft(key) {
      return get(/databases/$(database)/documents/payment-orders/$(key)).data.status == 'draft';
    }
    function createdByCaller() {
      return request.resource.data.get('createdBy', '') == request.auth.uid;
    }
    match /payment-orders/{id} {
      allow read: if isTreasurer() && tenantRead();
      allow create: if isTreasurer() && tenantCreate() && staysDraft() && createdByCaller();
      allow update: if isTreasurer() && tenantUpdate() && resource.data.status == 'draft' && staysDraft() && createdByCaller();
      allow delete: if false;
    }
    // Payments are written by onExpenseDone (admin SDK) only. A client may do exactly one thing to a
    // draft: confirm a flagged payment (needsReview true -> false). Anything wider would let the
    // approver rewrite IBAN/amount of a payment and then approve it — a four-eyes bypass.
    match /payments/{id} {
      allow read: if isTreasurer() && tenantRead();
      allow create: if false;
      allow update: if isTreasurer() && tenantUpdate() && resource.data.status == 'draft'
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsReview'])
                     && request.resource.data.needsReview == false
                     && orderIsDraft(resource.data.paymentOrderKey);
      allow delete: if isTreasurer() && canWriteTenant(resource.data) && resource.data.status == 'draft';
    }
    match /i18nDefault/{id}       { allow read: if tenantRead(); allow write: if false; }
    match /swissCities/{id}       { allow read: if tenantRead(); allow write: if false; }

    // ============================================================================
    //  OCR pipeline — ocr-results are written only by the OCR Cloud Functions
    //  (admin SDK bypasses rules); ocr-rules (vendor→account matching rules) are
    //  authored by treasurer/admin.
    // ============================================================================

    match /ocr-results/{id} { allow read: if tenantRead(); allow write: if false; }
    match /ocr-rules/{id}   { allow read: if tenantRead(); allow create, update: if (hasRole('treasurer') || isAdmin()) && tenantCreateOrDetach(); allow delete: if (hasRole('treasurer') || isAdmin()) && canWriteTenant(resource.data); }

    // ============================================================================
    //  Bank import (spec 1.60) — profiles and rules are treasurer config; the staging
    //  rows are client-written but a client may never mark one posted: only the
    //  postBankImport callable (admin SDK) sets status 'posted' / bookingKey.
    // ============================================================================
    match /bank-profiles/{id} { allow read: if tenantRead(); allow create, update: if (hasRole('treasurer') || isAdmin()) && tenantCreateOrDetach(); allow delete: if (hasRole('treasurer') || isAdmin()) && canWriteTenant(resource.data); }
    match /bank-rules/{id}    { allow read: if tenantRead(); allow create, update: if (hasRole('treasurer') || isAdmin()) && tenantCreateOrDetach(); allow delete: if (hasRole('treasurer') || isAdmin()) && canWriteTenant(resource.data); }
    match /bank-import-rows/{id} {
      allow read: if tenantRead();
      allow create: if (hasRole('treasurer') || isAdmin()) && tenantCreateOrDetach()
                    && request.resource.data.status in ['unmapped', 'mapped']
                    && request.resource.data.bookingKey == '';
      allow update: if (hasRole('treasurer') || isAdmin()) && tenantUpdate()
                    && resource.data.status != 'posted'
                    && request.resource.data.status in ['unmapped', 'mapped']
                    && request.resource.data.bookingKey == '';
      allow delete: if (hasRole('treasurer') || isAdmin()) && canWriteTenant(resource.data) && resource.data.status != 'posted';
    }

    // Reference data that may have an admin authoring UI — allow privileged writes.
    match /assets/{id}             { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    match /asset-categories/{id}   { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    // competition-levels keep their full dateOfBirth (SRV admin data) — read is
    // privileged-only (D-P4-3): only the AOC admin console consumes them.
    match /competition-levels/{id} { allow read: if isPrivileged() && tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    match /formDefinitions/{id}    { allow read: if tenantRead(); allow create, update: if isContentManager() && tenantCreateOrDetach(); allow delete: if isContentManager() && tenantDelete(); }
    // formStats (1.125 B, spec §11/§19): the response counter of a form (or of one section's own places).
    // Written only by submitForm (Admin SDK); authors read it for «7 von 8 Antworten». No personal data.
    match /formStats/{id}          { allow read: if isContentManager() && tenantRead(); allow write: if false; }
    match /periods/{id}            { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    match /responsibilities/{id}   { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    match /vat-codes/{id}          { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreateOrDetach(); allow delete: if isPrivileged() && tenantDelete(); }
    // workflow-rules decide who gets notified about a membership event (spec 1.35).
    // Admin-only writes: a mis-edited rule silently stops a notification. The engine
    // itself runs in a Cloud Function and bypasses these rules.
    match /workflow-rules/{id}     { allow read: if tenantRead(); allow create, update: if isAdmin() && tenantCreateOrDetach(); allow delete: if isAdmin() && tenantDelete(); }

    // Alias-Spaces sind Konfiguration: nur Admins legen sie an und ändern sie
    // (spec 2026-08-22-alias-service-spec.md). Gelöscht wird nicht — ein gelöschter Space
    // macht jeden seiner Aliase unauflösbar, auch die gedruckten; die UI archiviert.
    match /aliasSpaces/{id}  { allow read: if tenantRead(); allow create, update: if isAdmin() && tenantCreateOrDetach(); allow delete: if false; }

    // Aliase sind CF-write-only. Grund ist NICHT nur die Rolle: die Document-ID ist
    // deterministisch (<tenant>__<space>__<alias>, wobei das Alias-Segment gemäss
    // space.caseSensitive normalisiert wird), und ein Client-setDoc würde einen
    // bestehenden Alias still überschreiben statt zu kollidieren. Geprägt wird über die
    // Callables createAlias/resolveAlias, die .create() des Admin SDK benutzen.
    // Lesen darf jeder Tenant-Nutzer: ein lookup-Space (Diary) löst clientseitig auf.
    match /aliases/{id}      { allow read: if tenantRead(); allow write: if false; }

    // TTL-Policies sind AKTIV (2026-08-22, Teilprojekt 4) — geprüft mit
    // `gcloud firestore fields ttls list`. Sie sind der einzige Aufräummechanismus; es gibt
    // bewusst KEINE Aufräum-Function. Damit sie greifen, MUSS `expiresAt` ein echter
    // Firestore-Timestamp sein und nicht die sonst übliche StoreDate-Zeichenkette — eine
    // Zeichenkette liefe nie ab, und bei aliasEvents wäre das eine unbefristete Sammlung
    // von Personendaten. Gesetzt wurden sie mit:
    // gcloud firestore fields ttls update expiresAt --collection-group=aliasStats  --enable-ttl
    // gcloud firestore fields ttls update expiresAt --collection-group=aliasEvents --enable-ttl
    // Zugriffsstatistik: vom Resolver geschrieben, von der Detailseite gelesen.
    // aliasEvents trägt personenbezogene Daten (gehashte IP, uid) und ist deshalb
    // privilegiert — anders als das Aggregat.
    match /aliasStats/{id}   { allow read: if tenantRead(); allow write: if false; }
    match /aliasEvents/{id}  { allow read: if isPrivileged() && tenantRead(); allow write: if false; }

    // approvals carry a decision and who made it — an audit trail (spec 2026-08-15 §3.3).
    // CF-write-only, like expenses and bookings: decisions go through decideApproval,
    // which checks the snapshotted approver, or they do not happen.
    match /approvals/{id}          { allow read: if tenantRead(); allow write: if false; }
    // the workflow side-effect queue: written by the engine, performed by onWorkflowOutbox.
    // Readable by admins only — the payload holds recipient addresses.
    match /workflow-outbox/{id}    { allow read: if isAdmin() && tenantRead(); allow write: if false; }
    // Serienmail job queue (spec 2.96 §7): the composer creates the job, onMailJob performs it and
    // owns state/blocksSent/error — hence create-only. Same role as the Serienmail menu entries
    // (memberAdmin); the payload holds recipient addresses, so reading is gated the same way.
    match /mailJobs/{id}           {
      allow read:   if (isPrivileged() || hasRole('memberAdmin')) && tenantRead();
      // Exactly one tenant: `onMailJob` checks the sender against it and sends under it.
      // `category` ties the job's Mailtrap events to a Versand (getMailingDeliveries): only onMailing sets it.
      allow create: if (isPrivileged() || hasRole('memberAdmin')) && tenantCreate()
                       && request.resource.data.tenants.size() == 1
                       && !('category' in request.resource.data);
      allow update, delete: if false;
    }
    // mailings (spec 1.145 §10): one doc per Versand, written only by `sendMailing` (Admin SDK) and
    // updated by `onMailing`. memberAdmin / privileged may follow their tenant's sends; no client write.
    match /mailings/{id}           {
      allow read:   if (isPrivileged() || hasRole('memberAdmin')) && tenantRead();
      allow write:  if false;
    }
    // notices (spec 1.145 §10): the In-App delivery of a Versand, written only by `onMailing`. A
    // recipient reads it (the «my notices» query is `recipients array-contains <personKey>`, same shape
    // as contracts' partyPersonKeys), and so do memberAdmin / privileged of its tenant. Files are opened
    // through `getNoticeAttachment` only.
    match /notices/{id}            {
      allow read:   if (callerPersonKey() != '' && callerPersonKey() in resource.data.get('recipients', []))
                       || ((isPrivileged() || hasRole('memberAdmin')) && tenantRead());
      allow write:  if false;
    }
    // external-reports (spec 1.133 §8): marks that a case was reported to an external organisation
    // (SRV Sekretariat), so the next report only holds new cases. No names, only keys. Privileged or
    // memberAdmin of the tenant; the doc is written to the caller's own tenant only. No delete: a mark
    // is history (a wrong one is archived via isArchived, never removed).
    match /external-reports/{id}   {
      allow read:   if (isPrivileged() || hasRole('memberAdmin')) && tenantRead();
      allow create: if (isPrivileged() || hasRole('memberAdmin')) && tenantCreate();
      allow update: if (isPrivileged() || hasRole('memberAdmin')) && tenantUpdate();
    }

    // ============================================================================
    //  Templates (PDF) — role-gated; converted from dead claim checks to get()-roles.
    // ============================================================================

    // Until 2026-11-02 create/update checked only the role, neither the stored nor the new
    // `tenants`, so a privileged user of any tenant could rewrite any tenant's template (and its
    // versions). Create and update are split rather than tenantCreateOrDetach(): the update must
    // require the caller's tenant on the STORED doc (tenantUpdate), not only on the new one.
    match /templates/{templateId} {
      // Version docs carry no tenants[] — they belong to whichever tenant owns the parent.
      function parentTemplateExists() {
        return exists(/databases/$(database)/documents/templates/$(templateId));
      }
      function parentTemplate() {
        return get(/databases/$(database)/documents/templates/$(templateId)).data;
      }
      function isTemplateEditor() {
        return isPrivileged() || hasRole('contentAdmin');
      }
      function canEditParentTemplate() {
        return isTemplateEditor() && parentTemplateExists() && canWriteTenant(parentTemplate());
      }
      // Spec 1.141: the mail renderer finds email templates by fixed id and trusts a doc that names
      // exactly the expected owner. So a doc must not be able to come to look like another tenant's:
      // a template is created for one tenant, an email template (or any id of that family) only
      // under its creator's own `_<tenant>` key; the operator's ['system'] docs take the base keys.
      function templateCreateAllowed() {
        let data = request.resource.data;
        let tenants = data.tenants;
        return tenantCreate()
               && tenants.size() == 1
               && (tenants == ['system']
                   || (data.get('kind', 'pdf') == 'pdf'
                       ? !templateId.matches('email-.*')
                       : templateId.matches('.*_' + tenants[0])));
      }
      // `kind` never changes. `tenants` does not either, except that a tenant may detach itself from
      // a legacy multi-tenant PDF doc on delete. An email doc is never detached: create it with two
      // tenants (impossible now, not for an old doc), detach, and it would pass as the other's own.
      // No tenantUpdate() here: it would admit a new `tenants` holding the caller plus a foreign tenant.
      function templateUpdateAllowed() {
        let ts = callerTenants();
        let kind = resource.data.get('kind', 'pdf');
        return canWriteTenantFor(resource.data, ts)
               && request.resource.data.get('kind', 'pdf') == kind
               && (request.resource.data.tenants == resource.data.tenants
                   || (kind == 'pdf' && selfDetach()));
      }

      allow read:   if userExists() && (resource == null || belongsToTenant(resource.data));
      allow create: if isTemplateEditor() && templateCreateAllowed();
      allow update: if isTemplateEditor() && templateUpdateAllowed();
      allow delete: if isAdmin() && tenantDelete();

      match /versions/{versionId} {
        allow read:   if userExists() && parentTemplateExists() && belongsToTenant(parentTemplate());
        allow create: if canEditParentTemplate();
        allow update: if canEditParentTemplate() && resource.data.status == 'draft';
        // Einen unveröffentlichten Entwurf verwerfen gehört zum Editor ('Auf letzte Version
        // zurücksetzen' → TemplateService.discardDraft). Mit `if false` schlug dieser Löschvorgang
        // immer fehl, der Entwurf blieb liegen. Veröffentlichte Versionen bleiben unantastbar —
        // sie sind die Historie.
        allow delete: if canEditParentTemplate() && resource.data.status == 'draft';
      }
    }

    // ============================================================================
    //  Cloud-Function-owned collections (read constrained, writes denied).
    // ============================================================================

    match /docGenerations/{genId} {
      allow read:  if signedIn() && (resource == null || request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false;
    }
    // Evidence that a data-subject erasure ran (privacy 1.19, Phase 5B). Holds counts
    // per collection and a salted pseudonym — no name, no e-mail, no personKey, no uid,
    // and nothing that would reveal whether the person still exists in another tenant
    // (D-P5-2). Written by eraseMyData under the Admin SDK; never from a client.
    match /erasure-log/{docId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }
    // Tenant allocation audit (spec 1.47). Same shape as erasure-log — Cloud-Function-only
    // writes, admin reads scoped to the acting tenant — but this one DOES carry a personKey
    // (D-TA-5), so it is also a row in subject-data-map.ts.
    match /tenant-allocation-log/{docId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }
    // Quick file transfer (spec 1.115). Written by Cloud Functions only; recipients read via callables.
    match /file-transfers/{docId} {
      allow read: if tenantRead() && (resource == null || resource.data.senderKey == callerPersonKey() || isAdmin());
      allow write: if false;
    }
    // NewsCenter (design 2026-11-08 §6). Channels are club-curated: ONLY admin/contentAdmin of the
    // tenant write them, because the news relay fetches the stored `feedUrl` and allows http `newsImage`
    // only on `viaRelay` channels — a member-writable channel would be an SSRF/allowlist bypass.
    match /news-channels/{docId} {
      allow read:   if tenantRead();
      allow create: if isContentAdminOrAdmin() && tenantCreate();
      allow update: if isContentAdminOrAdmin() && tenantUpdate();
      allow delete: if false;
    }
    // Per-user subscriptions: doc id = the owner's uid. The tenants[] check keeps a doc from leaking across tenants.
    match /news-subscriptions/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid && tenantRead();
      allow create: if signedIn() && request.auth.uid == uid && tenantCreate();
      allow update: if signedIn() && request.auth.uid == uid && tenantUpdate();
      allow delete: if signedIn() && request.auth.uid == uid && tenantDelete();
    }
    // Channel requests: a member files one (open), the requester and content admins read, content admins decide.
    match /news-channel-requests/{docId} {
      allow read:   if tenantRead() && (resource == null || resource.data.requesterUid == request.auth.uid || isContentAdminOrAdmin());
      allow create: if tenantCreate()
                       && request.resource.data.requesterUid == request.auth.uid
                       && request.resource.data.status == 'open';
      allow update: if isContentAdminOrAdmin() && tenantUpdate()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'channelKey']);
      allow delete: if false;
    }
    match /file-transfer-events/{docId} {
      allow read: if tenantRead() && (resource == null || isAdmin() || resource.data.senderKey == callerPersonKey());
      allow write: if false;
    }
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }
    // Inbound webhook events (spec 1.142). Admin-SDK only.
    // Configure a Firestore TTL policy on `webhook-events.expiresAt`.
    match /webhook-events/{docId} {
      allow read, write: if false;
    }
    // External Data Gateway — provider response cache. Admin-SDK only.
    // Configure a Firestore TTL policy on `apiCache.expiresAt`.
    match /apiCache/{docId} {
      allow read, write: if false;
    }
    // External Data Gateway — durable monthly per-provider usage counters.
    // Configure a Firestore TTL policy on `_apiQuota.expiresAt`.
    match /_apiQuota/{docId} {
      allow read, write: if false;
    }
    match /stats_boats/{boatKey}/years/{year} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /stats_members/{memberKey}/years/{year} {
      allow read:  if signedIn();
      allow write: if false;
    }
    // '<boats|members>_<year>' — the whole ranking in one doc, written by Cloud Functions only.
    match /stats_rollup/{rollupId} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /esignList/{esignId} {
      // esign records carry a singular tenantId field (not a tenants[] array).
      // Contract-request runs (sourceRef 'approval.<okey>', spec 1.87) point at a member's contract
      // PDF: readable only by the esign operators — contentAdmin (the esign route's gate) and
      // privileged/admin. Rules are not filters: the esign screen's tenantId-only list query must
      // stay provable for its contentAdmin-only users, hence isContentManager(), not
      // isPrivileged(). Every other record (meeting.<okey>, uploads) keeps the tenant rule.
      allow read:  if userExists() && (resource == null || (
                      callerTenants().hasAny([resource.data.tenantId]) && (
                        !resource.data.get('sourceRef', '').matches('approval[.].*')
                        || isContentManager())));
      allow write: if false;
    }
    match /esignAudit/{tenantId}/{subcollection=**} {
      allow read, write: if false;
    }
    // Feature rollout (spec 2026-08-01-feature-building-blocks, D-BB-9/D-BB-10): a GLOBAL,
    // operator-owned collection — one doc per catalogue block id, no tenants[] field.
    // Readable by any authenticated user: the picker must show *withheld* blocks with
    // their reason, so a tenant can see a feature exists but is not available to them.
    // `allow write: if false` is deliberate, not an oversight — there is no operator
    // role in RoleName yet, and the sole writer is the applyFeatureSelection callable,
    // which uses the Admin SDK and bypasses rules entirely. Do not "fix" this by adding
    // an isAdmin()-style write rule; that would let a tenant admin grant themselves a
    // beta/internal block outside the operator's control.
    match /feature-rollout/{blockId} {
      allow read:  if signedIn();
      allow write: if false;
    }
    // Append-only audit trail of enable/disable transitions, written exclusively by the
    // same applyFeatureSelection callable (Admin SDK). Same reasoning as above: no
    // client — including an admin — may write here.
    match /featureEvents/{eventId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ============================================================================
    //  Applications — anonymous membership submissions (shape-constrained), with
    //  privileged review. (C-1 catch-all removal also makes this flow actually
    //  work — the previous undefined helper functions failed closed. M-11.)
    // ============================================================================

    match /applications/{appId} {
      allow read:   if isPrivileged() && (resource == null || belongsToTenant(resource.data));
      allow create: if request.resource.data.state == 'applied'
                     && request.resource.data.taskKey == ''
                     && request.resource.data.personKey == ''
                     && request.resource.data.tenants.size() == 1;
      allow update: if isPrivileged() && canWriteTenant(resource.data);
      allow delete: if false;
    }

    // ============================================================================
    //  Sessions — anonymous sessions created pre-auth, upgraded after login. (M-8)
    // ============================================================================

    match /sessions/{sessionId} {
      // Sessions carry userEmail — only the AOC admin console reads them, so
      // restrict to same-tenant admins (was: any signed-in user, cross-tenant —
      // privacy inventory §7.1).
      allow read:   if isAdmin() && (resource == null || belongsToTenant(resource.data));
      // Anonymous create: inactive userKey, single tenant.
      allow create: if request.resource.data.isActive == true
                     && request.resource.data.userKey == ''
                     && request.resource.data.tenants.size() == 1;
      // Update must not change the tenant, and must NOT forge userKey:
      // either userKey is unchanged (heartbeat / end-session) or it is being set
      // to the authenticated caller's own uid (login upgrade). (M-8)
      allow update: if resource.data.tenants == request.resource.data.tenants
                     && (
                          request.resource.data.userKey == resource.data.userKey
                          || (signedIn() && request.resource.data.userKey == request.auth.uid)
                        );
      allow delete: if false;
    }

    // ============================================================================
    //  Partner channel (spec 1.25 / C3) — bkaiser's back office, in tenant `kring`.
    //  Admin-read only: the registry carries a partner's contractual status and the
    //  credential-like `serviceUid`, and the ledger is the evidence the 10 % share is
    //  audited from.
    // ============================================================================

    match /partners/{partnerId} {
      allow read:   if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow create: if isAdmin() && canWriteTenant(request.resource.data);
      // `lastHeartbeatAt` and `reportedVersion` are the ingest function's to write.
      // An admin who could set them could fake the very heartbeat C2 §13.3's
      // termination right is read from.
      allow update: if isAdmin() && canWriteTenant(resource.data)
                     && request.resource.data.lastHeartbeatAt == resource.data.lastHeartbeatAt
                     && request.resource.data.reportedVersion == resource.data.reportedVersion;
      allow delete: if false;   // the UI archives (isArchived); history stays readable
    }

    // Written exclusively by the Admin SDK (`pushMetering`, `runCommission`). A client
    // that could write either side could make the audit agree with itself.
    match /meteringRecords/{recordId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }
    match /commissionEntries/{entryId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // The prospect pool (spec 1.30 / C5). Without this match the collection falls through to
    // the default deny below and the registry reads as permanently empty — the exact trap
    // that cost C3 a silent-empty screen.
    //
    // Admin-only, and no partner clause at all. A partner's access is "the open pool plus my
    // own claims, never another partner's": that is a predicate over document CONTENT, which
    // Firestore cannot evaluate for a list query. Any rule written to make such a list pass
    // grants more than it appears to. Partners therefore read and claim through the callables
    // (`listProspects` / `claimProspect` / `releaseProspect`), authenticated by
    // `PartnerModel.serviceUid` — never against a role and never against this rule.
    //
    // Writes are the Admin SDK's alone: `submitProspect` creates the record, `pushMetering`
    // observes the conversion (C5 §7 — never self-declared), and `revokeProspect` terminates
    // a claim. An admin who could edit a claim here could also register a conversion by hand.
    match /prospects/{prospectId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // The 3LS escalation queue (spec 1.29 / C4). Same shape as `prospects` above, and the
    // argument is not re-derived: "my tickets, never another partner's" is a predicate over
    // document CONTENT, which Firestore cannot evaluate for a list query, so a partner reads
    // and writes through the callables (`submitTicket` / `listTickets` / `commentTicket`),
    // authenticated by `PartnerModel.serviceUid` — never a `partner` role, never this rule.
    //
    // Writes are the Admin SDK's alone even for bkaiser's own admins, and that is the point.
    // `classification` decides free vs. chargeable (C4 §4) and is an AUDITED field: it may only
    // be set together with a reason and an author, which `classifyTicket` enforces and a rule
    // cannot. An admin who could write this document directly could bill a partner with no
    // reason on the record. Status and the two SLA legs go through `triageTicket` for the same
    // reason — `waitingDays` is banked on each transition and is not reconstructible afterwards.
    match /tickets/{ticketId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // ============================================================================
    //  Default deny — no catch-all grant. Any collection not matched above is
    //  denied. (C-1: the previous `match /{document=**} { allow read, write:
    //  if request.auth != null }` is removed entirely.)
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
