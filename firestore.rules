rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    //  Helpers — authorization is derived from the caller's users/{uid} document,
    //  NOT from custom claims. Custom claims (token.admin / token.contentAdmin /
    //  token.tenantId) are never minted anywhere in this project, so claim-based
    //  checks would always be false. The user doc carries:
    //    - roles:   map<RoleName, bool>   (e.g. { admin: true, contentAdmin: true })
    //    - tenants: string[]              (always exactly one tenant per user)
    //  Every stored model carries tenants: string[]; the 'system' tenant denotes
    //  shared/global data readable by every tenant.
    // ============================================================================

    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userExists() {
      return signedIn() && exists(userPath());
    }
    function userData() {
      return get(userPath()).data;
    }
    function callerTenants() {
      return userExists() ? userData().tenants : [];
    }
    function hasRole(role) {
      return userExists() && userData().roles.get(role, false) == true;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isPrivileged() {
      return hasRole('privileged') || isAdmin();
    }
    // CMS content (pages/sections/menuItems/categories) is authored in the
    // privileged CMS UI; writes require the content role (M-7).
    function isContentManager() {
      return hasRole('contentAdmin') || isPrivileged();
    }
    // ── addresses vault (privacy 1.19 Phase 4 lock) ─────────────────────────────
    // The caller owns an address when its parentKey points at their own person.
    function ownsParent(data) {
      return userExists() && data.parentKey == 'person.' + userData().personKey;
    }
    // Sensitive scalar channels: values whose channel floor is `privileged` —
    // never readable at the registered tier, writes gated below.
    function isSensitiveChannel(data) {
      return data.addressChannel in ['ssn', 'dob', 'dod', 'bankaccount'];
    }
    // Who may write sensitive-channel addresses: the owner (self-service),
    // privileged, or memberAdmin (authorized editor per D9).
    function canWriteSensitive(data) {
      return ownsParent(data) || isPrivileged() || hasRole('memberAdmin');
    }
    // Who may read the vault at all (D-P4-1, amended 2026-07-27): owner,
    // privileged, or memberAdmin. memberAdmin is the authorized ssn/dob editor
    // (D9) and could already obtain every value through the getAddressView
    // callable, so denying the raw read bought no confidentiality — it only
    // broke read-then-write flows (duplicate vault docs) and the QR-slip/export
    // paths. Plain members remain locked out; they read the projection.
    function canReadVault(data) {
      return ownsParent(data) || ((isPrivileged() || hasRole('memberAdmin')) && belongsToTenant(data));
    }
    // ── avatars (privacy 1.19, D-P4-10) ─────────────────────────────────────────
    // A person's avatar is a picture OF that person; the avatar doc id is the prefixed
    // key `person.<personKey>` (newAvatarModel). Until 2026-08-01 any member of the
    // tenant could create or replace it, i.e. upload a portrait of someone else as that
    // person's picture — precisely the case the photo declaration (`usageImages`) is
    // about. Person avatars are therefore owner-or-memberAdmin; every other avatar
    // (org, resource, section, …) stays ordinary tenant content, written by whoever
    // maintains that record. This is a write gate only: it does NOT make `usageImages`
    // enforceable — the bytes are served unsigned from the imgix CDN.
    // The doc id is tenant-scoped (`p13.person.kaiser`, this tenant's own picture) or bare
    // (`person.kaiser`, the shared default every tenant falls back to) — both shapes count.
    function isPersonAvatar(id) {
      return id.matches('^([^.]+[.])?person[.].*');
    }
    function canWriteAvatar(id) {
      return !isPersonAvatar(id)
             || id.matches('^([^.]+[.])?person[.]' + callerPersonKey() + '$')
             || isPrivileged() || hasRole('memberAdmin');
    }
    // A document belongs to the caller's tenant when their tenant is listed on the
    // document, or when the document is shared via the 'system' tenant.
    function belongsToTenant(data) {
      return data.tenants.hasAny(callerTenants()) || data.tenants.hasAny(['system']);
    }
    // A get() on a NON-EXISTENT document evaluates rules with resource == null.
    // Dereferencing resource.data.tenants there raises an error → the client sees
    // "Missing or insufficient permissions" instead of a clean not-found (breaks the
    // common read-then-create / existence-check pattern, e.g. FolderService.
    // ensureGroupFolder). Reading a non-existent doc returns nothing, so allow it;
    // list/query results always have a concrete resource, so belongsToTenant still
    // fully gates real data.
    function tenantRead() {
      return userExists() && (resource == null || belongsToTenant(resource.data));
    }
    function tenantCreate() {
      return userExists() && belongsToTenant(request.resource.data);
    }
    function tenantUpdate() {
      return userExists() && belongsToTenant(resource.data) && belongsToTenant(request.resource.data);
    }
    function tenantDelete() {
      return userExists() && belongsToTenant(resource.data);
    }
    // The `index` search string is a plain field on a tenant-readable document, so a
    // sensitive value embedded there (`dob:19850101`) leaks past the field-level
    // resurrection guard — that is exactly how the stripped dob survived Phase 4 in
    // production until 2026-07-27 (rebuilt by scripts/rebuild-person-index.mjs).
    // matches() is full-string RE2, hence the leading/trailing `.*`.
    function indexHasNoSensitivePii() {
      return !request.resource.data.get('index', '').matches('.*(dob|ssn|iban):.*');
    }
    // personKey of the caller (from their users/{uid} doc); '' when absent.
    function callerPersonKey() {
      return userExists() ? userData().get('personKey', '') : '';
    }
    // Folder lookup for member-upload / folder-owner checks (spec 1.22).
    function folderData(folderKey) {
      return get(/databases/$(database)/documents/folders/$(folderKey)).data;
    }

    // ============================================================================
    //  Public read — only what an unauthenticated client genuinely renders.
    //
    //  The public-facing static websites (apps/*-website) do NOT read Firestore
    //  directly — they fetch curated, field-mapped JSON from the publicApi Cloud
    //  Function (server-side, Admin SDK), which is the single public gateway.
    //
    //  The only browser path that reads Firestore anonymously is the PWA's
    //  public/* landing (cms-page PageDispatcher → pages + sections, ungated),
    //  plus the app-config / app-version bootstrap docs. Everything else
    //  (orgs/resources/tags/categories) is loaded by AppStore only after login
    //  (its resources are gated on fbUser), so it must NOT be world-readable.
    //
    //  CMS content (pages/sections/menuItems/categories) writes are content-role
    //  gated (M-7).
    // ============================================================================

    match /app-config/{tenant} {
      allow read: if true;
      // App configuration is admin territory — but only for your OWN tenant: the
      // doc id IS the tenantId, so without this check a privileged user of tenant A
      // could overwrite app-config/B.
      allow create, delete: if isPrivileged() && (tenant in callerTenants());
      // ...except for the fields that are NOT the tenant's own business.
      //
      // `enabledFeatures` is a BILLING boundary (1.32 §8.5): a tenant admin who can
      // switch on a paid add-on is one who can stop paying for it. Feature selection is
      // server-side by design anyway (D-BB-9 — the `applyFeatureSelection` callable uses
      // the Admin SDK and bypasses rules), so denying it here costs the client nothing;
      // `feature-selection.service.ts` never writes the field.
      //
      // The same list takes the E2EE key-management flag when 1.33 lands. There it is a
      // SECURITY boundary, and sharpest in the DOWNGRADE direction — a tenant admin must
      // not be able to turn self-managed keys back off for everyone.
      //
      // `affectedKeys()` reports only keys whose value actually CHANGED, so the AOC
      // config editor writing the whole document back with the field untouched still passes.
      allow update: if isPrivileged() && (tenant in callerTenants())
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['enabledFeatures']);
    }
    match /app-version/{doc} {
      allow read: if true;
      allow write: if false;                          // updated out-of-band / by admin tooling
    }
    // Global integration config singletons (e.g. config/bexioSync sync pointers).
    // Read by the admin-only AOC console; written exclusively by Cloud Functions
    // (Admin SDK, bypasses rules).
    match /config/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Server-only secrets (per-tenant API keys, e.g. searchChApiKey). Never
    // client-readable/writable; Cloud Functions reach these via the Admin SDK,
    // which bypasses these rules.
    match /app-secrets/{tenantId} {
      allow read, write: if false;
    }
    // CMS content rendered by the anonymous PWA landing — public read.
    match /pages/{id}           { allow read: if true; allow create, update: if isContentManager() && belongsToTenant(request.resource.data); allow delete: if isContentManager() && belongsToTenant(resource.data); }
    match /sections/{id}        { allow read: if true; allow create, update: if isContentManager() && belongsToTenant(request.resource.data); allow delete: if isContentManager() && belongsToTenant(resource.data); }
    // menuItems/categories: navigation + select metadata. menuItems is read by the
    // app shell's menu store (ungated); categories are CMS select-lists. Low
    // sensitivity, kept public-readable; writes are content-role gated.
    match /categories/{id}      { allow read: if true; allow create, update: if isContentManager() && belongsToTenant(request.resource.data); allow delete: if isContentManager() && belongsToTenant(resource.data); }
    // Fork-on-edit (feature-building-blocks D-BB-8): a tenant customising a SHARED,
    // catalogue-owned menu doc copies it and then detaches itself from the original. That
    // detach leaves a document the caller no longer belongs to, so the ordinary
    // belongsToTenant(request.resource.data) check would deny it. Allow exactly that one
    // shape: the caller already belonged, `tenants` is the ONLY field changed, and the new
    // value is the old one minus the caller's own tenant — so it can drop itself and nobody
    // else, and cannot smuggle any other edit through the same write.
    function isSelfDetach() {
      return isContentManager()
             && belongsToTenant(resource.data)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenants'])
             && request.resource.data.tenants == resource.data.tenants.removeAll(callerTenants());
    }
    // Nobody may evict ANOTHER tenant from a shared menu doc — that would break their menu
    // from across the tenant boundary. Un-seeding is applyFeatureSelection's job (Admin SDK,
    // rules bypassed), never a client's. Every tenant but the caller's own must survive the
    // write; the caller's own may go (that is isSelfDetach) or stay (an ordinary edit).
    function keepsForeignTenants() {
      return request.resource.data.tenants.hasAll(resource.data.tenants.removeAll(callerTenants()));
    }
    match /menuItems/{id}       { allow read: if true; allow create: if isContentManager() && belongsToTenant(request.resource.data); allow update: if keepsForeignTenants() && ((isContentManager() && belongsToTenant(request.resource.data)) || isSelfDetach()); allow delete: if isContentManager() && belongsToTenant(resource.data); }
    // tags/orgs/resources: NOT public. Read only by authenticated tenant members
    // (AppStore loads them post-login). The static websites get any org info via
    // the publicApi CF, never by reading these collections directly. (M-7)
    match /tags/{id}            { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    // orgs: resurrection guard (spec 1.19 Phase 4) — stripped favEmail/favPhone
    // must never reappear on the doc.
    match /orgs/{id} {
      allow read:   if tenantRead();
      allow create: if tenantCreate() && !request.resource.data.keys().hasAny(['favEmail', 'favPhone']);
      allow update: if tenantUpdate() && !request.resource.data.keys().hasAny(['favEmail', 'favPhone']);
      allow delete: if tenantDelete();
    }
    match /resources/{id}       { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }

    // ============================================================================
    //  Users — own doc, with role/tenant/personKey escalation blocked. (C-1)
    // ============================================================================

    match /users/{userId} {
      // Read your own doc; admins/privileged may read others within their tenant.
      allow read: if signedIn() && (request.auth.uid == userId
                    || (isPrivileged() && belongsToTenant(resource.data)));

      // Self-service create of your own doc is allowed only without elevated roles;
      // admins may create within their tenant. (User provisioning normally happens
      // via the Admin SDK, which bypasses rules.)
      allow create: if signedIn() && (
                       (request.auth.uid == userId
                          && !request.resource.data.roles.get('admin', false)
                          && !request.resource.data.roles.get('privileged', false))
                       || (isAdmin() && belongsToTenant(request.resource.data))
                    );

      // Update your own doc but NOT roles / tenants / personKey; admins may update
      // users of their own tenant only (both before and after the write, so an
      // admin cannot pull a foreign user into their tenant or push one out).
      allow update: if signedIn() && (
                       (request.auth.uid == userId
                          && !request.resource.data.diff(resource.data).affectedKeys()
                                .hasAny(['roles', 'tenants', 'personKey']))
                       || (isAdmin() && belongsToTenant(resource.data)
                                     && belongsToTenant(request.resource.data))
                    );

      allow delete: if isAdmin() && belongsToTenant(resource.data);

      // FCM push tokens are owned by the user. (C-1 — previously any authed user
      // could read/write anyone's tokens via the catch-all.)
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // ============================================================================
    //  Tenant-scoped, client-writable collections.
    //  Phase 1: any authenticated member of the document's tenant. Per-collection
    //  role tightening (memberAdmin for persons, treasurer for accounting, …) is
    //  Phase 2.
    // ============================================================================

    match /accounting-configs/{id} { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /accounts/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    // Activities are the audit log. Authenticated tenant members write normal activities.
    // Auth-scope events (login/logout) are logged by ActivityService.logAuth pre-auth or
    // during the post-signIn token-propagation race, i.e. with request.auth == null. Allow
    // that ONE shape-constrained anonymous create (empty author.key, single tenant) so failed
    // and racing logins still land in the audit trail — mirrors the sessions anonymous create.
    match /activities/{id} {
      allow read:   if tenantRead();
      allow create: if tenantCreate()
                     || (request.resource.data.scope == 'auth'
                          && request.resource.data.author.key == ''
                          && request.resource.data.tenants.size() == 1);
      allow update: if tenantCreate();
      allow delete: if tenantDelete();
    }
    // addresses = PII vault (spec 1.19 Phase 4 lock): raw read only for the owner,
    // privileged, or memberAdmin (D-P4-1 as amended); plain members read the
    // address-directory projection or the getAddressView callable. Sensitive
    // channels (ssn/dob/bankaccount) are writable only by owner/privileged/memberAdmin.
    match /addresses/{id} {
      // resource == null: a get() on a missing doc — allow the clean not-found
      // (same rationale as tenantRead(); list results always have a concrete resource).
      allow read:   if userExists() && (resource == null || canReadVault(resource.data));
      allow create: if tenantCreate()
                     && (!isSensitiveChannel(request.resource.data) || canWriteSensitive(request.resource.data));
      allow update: if tenantUpdate()
                     && (!(isSensitiveChannel(resource.data) || isSensitiveChannel(request.resource.data))
                         || canWriteSensitive(resource.data));
      allow delete: if tenantDelete()
                     && (!isSensitiveChannel(resource.data) || canWriteSensitive(resource.data));
    }
    // Person avatars follow the person, not the uploading tenant. Persons are shared
    // across tenants (persons/kaiser lives in 6) but newAvatarModel stamps the avatar
    // doc with the single tenant that uploaded it, so every OTHER tenant hit "Missing
    // or insufficient permissions" on avatars/person.<key> — read and re-upload alike.
    // The doc carries only a storagePath and the bytes are served unsigned from imgix,
    // so cross-tenant access leaks nothing; canWriteAvatar still limits writes to the
    // subject, privileged or memberAdmin. Non-person avatars (org, resource, section, …)
    // stay ordinary tenant content.
    // Read is NOT id-conditional: AvatarService streams the whole collection
    // (tenants array-contains <tenant>, person + org + resource docs mixed), and a rule
    // whose outcome depends on {id} is not provable for a list query — Firestore denied
    // the whole stream, so every avatar in every app fell back to the default icon.
    // A plain `userExists()` read is the same exposure the person case already accepted:
    // the doc carries only a storagePath and the bytes are served unsigned from imgix.
    match /avatars/{id}            { allow read: if userExists(); allow create, update: if (isPersonAvatar(id) ? userExists() : tenantCreate()) && canWriteAvatar(id); allow delete: if (isPersonAvatar(id) ? userExists() : tenantDelete()) && canWriteAvatar(id); }
    match /calendars/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /calevents/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /comments/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    // docs + folders (spec 1.22 — event image folders):
    // members may create docs only into a membersMayUpload folder, as themselves;
    // authors manage their own docs; the folder owner may moderate (delete/update) docs in their folder.
    match /docs/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && (
        isContentManager()
        || (callerPersonKey() != ''
            && request.resource.data.get('authorKey', '') == callerPersonKey()
            && request.resource.data.get('folderKeys', []).size() > 0
            && belongsToTenant(folderData(request.resource.data.folderKeys[0]))
            && folderData(request.resource.data.folderKeys[0]).get('membersMayUpload', false) == true));
      allow update: if tenantUpdate() && (
        isContentManager()
        || (callerPersonKey() != ''
            && resource.data.get('authorKey', '') == callerPersonKey()
            && request.resource.data.get('authorKey', '') == resource.data.get('authorKey', '')
            && request.resource.data.get('folderKeys', []) == resource.data.get('folderKeys', []))
        || (callerPersonKey() != ''
            && resource.data.get('folderKeys', []).size() > 0
            && belongsToTenant(folderData(resource.data.folderKeys[0]))
            && folderData(resource.data.folderKeys[0]).get('ownerKey', '') == callerPersonKey()
            && request.resource.data.get('authorKey', '') == resource.data.get('authorKey', '')
            && request.resource.data.get('folderKeys', []) == resource.data.get('folderKeys', [])));
      allow delete: if tenantDelete() && (
        isAdmin()
        || (callerPersonKey() != '' && resource.data.get('authorKey', '') == callerPersonKey())
        || (callerPersonKey() != ''
            && resource.data.get('folderKeys', []).size() > 0
            && belongsToTenant(folderData(resource.data.folderKeys[0]))
            && folderData(resource.data.folderKeys[0]).get('ownerKey', '') == callerPersonKey()));
    }
    match /folders/{id} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && (
        isContentManager()
        || (callerPersonKey() != '' && request.resource.data.get('ownerKey', '') == callerPersonKey()));
      allow update: if tenantUpdate() && (
        isContentManager()
        || (callerPersonKey() != '' && resource.data.get('ownerKey', '') == callerPersonKey()));
      allow delete: if tenantDelete() && (
        isContentManager()
        || (callerPersonKey() != '' && resource.data.get('ownerKey', '') == callerPersonKey()));
    }
    match /groups/{id}             { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /i18nTenantOverride/{id} { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /icons/{id}              { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /invitations/{id}        { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /locations/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /memberships/{id}        { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /ownerships/{id}         { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /personal-rels/{id}      { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    // persons: resurrection guard (spec 1.19 Phase 4) — the stripped PII fields
    // (ssnId/dateOfBirth/dateOfDeath/favEmail/favPhone) must never reappear on the doc.
    // dateOfDeath moved to the 'dod' vault channel; persons keep only the isDeceased flag.
    match /persons/{id} {
      allow read:   if tenantRead();  // C-2: no longer public
      allow create: if tenantCreate()
                     && !request.resource.data.keys().hasAny(['ssnId', 'dateOfBirth', 'dateOfDeath', 'favEmail', 'favPhone'])
                     && indexHasNoSensitivePii();
      allow update: if tenantUpdate()
                     && !request.resource.data.keys().hasAny(['ssnId', 'dateOfBirth', 'dateOfDeath', 'favEmail', 'favPhone'])
                     && indexHasNoSensitivePii();
      allow delete: if tenantDelete();
    }
    match /reservations/{id}       { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /scs-memberfees/{id}     { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /tasks/{id}              { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /transfers/{id}          { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /trips/{id}              { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /websiteContent/{id}     { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }
    match /workrels/{id}           { allow read: if tenantRead(); allow create, update: if tenantCreate(); allow delete: if tenantDelete(); }

    // Kiosk device telemetry (battery + heartbeat), document id = the kiosk user's uid.
    // A device may only write its OWN doc; any member of the tenant may read it, admins
    // may clean up a retired kiosk. Never carries PII — uid, device model, battery, time.
    match /kiosk-status/{uid} {
      allow read: if tenantRead();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && belongsToTenant(request.resource.data);
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // ============================================================================
    //  Read-only on the client (written by Cloud Functions / bexio sync / seed).
    //  Tenant-scoped read; writes denied. If an admin UI legitimately writes one
    //  of these, switch its write to: isPrivileged() && belongsToTenant(request.resource.data)
    // ============================================================================

    // Materialized privacy projection of addresses (spec 1.19 Phase 4): built by
    // the replication CFs from the §A3 formula; contains ONLY registered-visible
    // contact data, so any tenant member may read it. Never client-writable.
    match /address-directory/{id}  { allow read: if tenantRead(); allow write: if false; }
    match /asset-movements/{id}    { allow read: if tenantRead(); allow write: if false; }
    match /bills/{id}              { allow read: if tenantRead(); allow write: if false; }
    match /booking-lines/{id}      { allow read: if tenantRead(); allow write: if false; }
    match /bookings/{id}          { allow read: if tenantRead(); allow write: if false; }
    match /exchange-rates/{id}    { allow read: if tenantRead(); allow write: if false; }
    match /expense-documents/{id} { allow read: if tenantRead(); allow write: if false; }
    match /expenses/{id}          { allow read: if tenantRead(); allow write: if false; }
    match /invoice-positions/{id} { allow read: if tenantRead(); allow write: if false; }
    match /invoices/{id}          { allow read: if tenantRead(); allow write: if false; }
    match /journallogs/{id}       { allow read: if tenantRead(); allow write: if false; }
    match /payment-orders/{id}    { allow read: if tenantRead(); allow write: if false; }
    match /payments/{id}          { allow read: if tenantRead(); allow write: if false; }
    match /i18nDefault/{id}       { allow read: if tenantRead(); allow write: if false; }
    match /swissCities/{id}       { allow read: if tenantRead(); allow write: if false; }

    // ============================================================================
    //  OCR pipeline — ocr-results are written only by the OCR Cloud Functions
    //  (admin SDK bypasses rules); ocr-rules (vendor→account matching rules) are
    //  authored by treasurer/admin.
    // ============================================================================

    match /ocr-results/{id} { allow read: if tenantRead(); allow write: if false; }
    match /ocr-rules/{id}   { allow read: if tenantRead(); allow create, update: if (hasRole('treasurer') || isAdmin()) && belongsToTenant(request.resource.data); allow delete: if (hasRole('treasurer') || isAdmin()) && belongsToTenant(resource.data); }

    // Reference data that may have an admin authoring UI — allow privileged writes.
    match /assets/{id}             { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }
    match /asset-categories/{id}   { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }
    // competition-levels keep their full dateOfBirth (SRV admin data) — read is
    // privileged-only (D-P4-3): only the AOC admin console consumes them.
    match /competition-levels/{id} { allow read: if isPrivileged() && tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }
    match /formDefinitions/{id}    { allow read: if tenantRead(); allow create, update: if isContentManager() && tenantCreate(); allow delete: if isContentManager() && tenantDelete(); }
    match /periods/{id}            { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }
    match /responsibilities/{id}   { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }
    match /vat-codes/{id}          { allow read: if tenantRead(); allow create, update: if isPrivileged() && tenantCreate(); allow delete: if isPrivileged() && tenantDelete(); }

    // ============================================================================
    //  Templates (PDF) — role-gated; converted from dead claim checks to get()-roles.
    // ============================================================================

    match /templates/{templateId} {
      allow read:          if userExists() && belongsToTenant(resource.data);
      allow create, update: if isPrivileged() || hasRole('contentAdmin');
      allow delete:        if isAdmin();

      match /versions/{versionId} {
        allow read:   if signedIn();
        allow create: if isPrivileged() || hasRole('contentAdmin');
        allow update: if (isPrivileged() || hasRole('contentAdmin')) && resource.data.status == 'draft';
        allow delete: if false;
      }
    }

    // ============================================================================
    //  Cloud-Function-owned collections (read constrained, writes denied).
    // ============================================================================

    match /docGenerations/{genId} {
      allow read:  if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false;
    }
    // Evidence that a data-subject erasure ran (privacy 1.19, Phase 5B). Holds counts
    // per collection and a salted pseudonym — no name, no e-mail, no personKey, no uid,
    // and nothing that would reveal whether the person still exists in another tenant
    // (D-P5-2). Written by eraseMyData under the Admin SDK; never from a client.
    match /erasure-log/{docId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }
    // External Data Gateway — provider response cache. Admin-SDK only.
    // Configure a Firestore TTL policy on `apiCache.expiresAt`.
    match /apiCache/{docId} {
      allow read, write: if false;
    }
    // External Data Gateway — durable monthly per-provider usage counters.
    // Configure a Firestore TTL policy on `_apiQuota.expiresAt`.
    match /_apiQuota/{docId} {
      allow read, write: if false;
    }
    match /stats_boats/{boatKey}/years/{year} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /stats_members/{memberKey}/years/{year} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /esignList/{esignId} {
      // esign records carry a singular tenantId field (not a tenants[] array).
      allow read:  if userExists() && callerTenants().hasAny([resource.data.tenantId]);
      allow write: if false;
    }
    match /esignAudit/{tenantId}/{subcollection=**} {
      allow read, write: if false;
    }
    // Feature rollout (spec 2026-08-01-feature-building-blocks, D-BB-9/D-BB-10): a GLOBAL,
    // operator-owned collection — one doc per catalogue block id, no tenants[] field.
    // Readable by any authenticated user: the picker must show *withheld* blocks with
    // their reason, so a tenant can see a feature exists but is not available to them.
    // `allow write: if false` is deliberate, not an oversight — there is no operator
    // role in RoleName yet, and the sole writer is the applyFeatureSelection callable,
    // which uses the Admin SDK and bypasses rules entirely. Do not "fix" this by adding
    // an isAdmin()-style write rule; that would let a tenant admin grant themselves a
    // beta/internal block outside the operator's control.
    match /feature-rollout/{blockId} {
      allow read:  if signedIn();
      allow write: if false;
    }
    // Append-only audit trail of enable/disable transitions, written exclusively by the
    // same applyFeatureSelection callable (Admin SDK). Same reasoning as above: no
    // client — including an admin — may write here.
    match /featureEvents/{eventId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ============================================================================
    //  Applications — anonymous membership submissions (shape-constrained), with
    //  privileged review. (C-1 catch-all removal also makes this flow actually
    //  work — the previous undefined helper functions failed closed. M-11.)
    // ============================================================================

    match /applications/{appId} {
      allow read:   if isPrivileged() && belongsToTenant(resource.data);
      allow create: if request.resource.data.state == 'applied'
                     && request.resource.data.taskKey == ''
                     && request.resource.data.personKey == ''
                     && request.resource.data.tenants.size() == 1;
      allow update: if isPrivileged() && belongsToTenant(resource.data);
      allow delete: if false;
    }

    // ============================================================================
    //  Sessions — anonymous sessions created pre-auth, upgraded after login. (M-8)
    // ============================================================================

    match /sessions/{sessionId} {
      // Sessions carry userEmail — only the AOC admin console reads them, so
      // restrict to same-tenant admins (was: any signed-in user, cross-tenant —
      // privacy inventory §7.1).
      allow read:   if isAdmin() && (resource == null || belongsToTenant(resource.data));
      // Anonymous create: inactive userKey, single tenant.
      allow create: if request.resource.data.isActive == true
                     && request.resource.data.userKey == ''
                     && request.resource.data.tenants.size() == 1;
      // Update must not change the tenant, and must NOT forge userKey:
      // either userKey is unchanged (heartbeat / end-session) or it is being set
      // to the authenticated caller's own uid (login upgrade). (M-8)
      allow update: if resource.data.tenants == request.resource.data.tenants
                     && (
                          request.resource.data.userKey == resource.data.userKey
                          || (signedIn() && request.resource.data.userKey == request.auth.uid)
                        );
      allow delete: if false;
    }

    // ============================================================================
    //  Partner channel (spec 1.25 / C3) — bkaiser's back office, in tenant `kring`.
    //  Admin-read only: the registry carries a partner's contractual status and the
    //  credential-like `serviceUid`, and the ledger is the evidence the 10 % share is
    //  audited from.
    // ============================================================================

    match /partners/{partnerId} {
      allow read:   if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow create: if isAdmin() && belongsToTenant(request.resource.data);
      // `lastHeartbeatAt` and `reportedVersion` are the ingest function's to write.
      // An admin who could set them could fake the very heartbeat C2 §13.3's
      // termination right is read from.
      allow update: if isAdmin() && belongsToTenant(resource.data)
                     && request.resource.data.lastHeartbeatAt == resource.data.lastHeartbeatAt
                     && request.resource.data.reportedVersion == resource.data.reportedVersion;
      allow delete: if false;   // the UI archives (isArchived); history stays readable
    }

    // Written exclusively by the Admin SDK (`pushMetering`, `runCommission`). A client
    // that could write either side could make the audit agree with itself.
    match /meteringRecords/{recordId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }
    match /commissionEntries/{entryId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // The prospect pool (spec 1.30 / C5). Without this match the collection falls through to
    // the default deny below and the registry reads as permanently empty — the exact trap
    // that cost C3 a silent-empty screen.
    //
    // Admin-only, and no partner clause at all. A partner's access is "the open pool plus my
    // own claims, never another partner's": that is a predicate over document CONTENT, which
    // Firestore cannot evaluate for a list query. Any rule written to make such a list pass
    // grants more than it appears to. Partners therefore read and claim through the callables
    // (`listProspects` / `claimProspect` / `releaseProspect`), authenticated by
    // `PartnerModel.serviceUid` — never against a role and never against this rule.
    //
    // Writes are the Admin SDK's alone: `submitProspect` creates the record, `pushMetering`
    // observes the conversion (C5 §7 — never self-declared), and `revokeProspect` terminates
    // a claim. An admin who could edit a claim here could also register a conversion by hand.
    match /prospects/{prospectId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // The 3LS escalation queue (spec 1.29 / C4). Same shape as `prospects` above, and the
    // argument is not re-derived: "my tickets, never another partner's" is a predicate over
    // document CONTENT, which Firestore cannot evaluate for a list query, so a partner reads
    // and writes through the callables (`submitTicket` / `listTickets` / `commentTicket`),
    // authenticated by `PartnerModel.serviceUid` — never a `partner` role, never this rule.
    //
    // Writes are the Admin SDK's alone even for bkaiser's own admins, and that is the point.
    // `classification` decides free vs. chargeable (C4 §4) and is an AUDITED field: it may only
    // be set together with a reason and an author, which `classifyTicket` enforces and a rule
    // cannot. An admin who could write this document directly could bill a partner with no
    // reason on the record. Status and the two SLA legs go through `triageTicket` for the same
    // reason — `waitingDays` is banked on each transition and is not reconstructible afterwards.
    match /tickets/{ticketId} {
      allow read:  if isAdmin() && (resource == null || belongsToTenant(resource.data));
      allow write: if false;
    }

    // ============================================================================
    //  Default deny — no catch-all grant. Any collection not matched above is
    //  denied. (C-1: the previous `match /{document=**} { allow read, write:
    //  if request.auth != null }` is removed entirely.)
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
