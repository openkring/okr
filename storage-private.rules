rules_version = '2';

// The private bucket (spec 1.74, 1.82). Clients read here only for tracker thumbnails
// (tenant/*/tracks/**, owner-only); everything else is delivered as signed URLs from Cloud
// Functions (signVideoUrls, signFinanceDocuments). The other client write is an album video
// upload. Finance files, exports and everything else written by the Admin SDK need no grant.
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function inTenant(tenantId) {
      return request.auth != null && firestore.exists(userPath())
        && (tenantId in firestore.get(userPath()).data.tenants);
    }
    // Same 200 MB as MAX_VIDEO_BYTES (libs/shared/util-core/src/lib/video.util.ts), album uploads only:
    // chat videos come through prepareChatVideoUpload's signed URL (MAX_CHAT_VIDEO_BYTES, 100 MB),
    // which bypasses these rules. `<=` like the client check (size > max is refused).
    function videoSizeOk() { return request.resource.size <= 200 * 1024 * 1024; }
    // By extension, never by contentType — see storage.rules isVideoUpload().
    function isVideoUpload() { return request.resource.name.lower().matches('.*[.](mp4|mov|avi)'); }
    // A folder that carries a room audience (chat room album) takes no client write: those videos
    // arrive only via the signed URL from prepareChatVideoUpload, which bypasses rules. Only the
    // path's own folder is read (no ancestor walk in rules), so prepareChatVideoUpload stamps the
    // room on all three album folders. Legacy folder docs have no matrixRoomId (read as ''). A
    // missing folder doc errors, which denies.
    function folderHasNoRoom(key) {
      return firestore.get(/databases/(default)/documents/folders/$(key)).data.get('matrixRoomId', '') == '';
    }

    match /tenant/{tenantId}/{modelType}/{key}/album/{sub}/{path=**} {
      allow create: if inTenant(tenantId)
        && (modelType == 'section' || (modelType == 'folder' && folderHasNoRoom(key)))
        && sub != 'renderings'
        && isVideoUpload() && videoSizeOk();
    }
    // Thumbnails of tracker photos (tracker spec §6). Owner = the person on the trip's track, by
    // personKey and across tenants (one person, several tenants). Read by the client with the
    // Storage SDK: the exception to "clients never read here". firestore.get on a missing
    // user or trip errors, which denies (fail closed).
    function trackOwner(tripKey) {
      return request.auth != null
        && firestore.get(userPath()).data.get('personKey', '') != ''
        && firestore.get(/databases/(default)/documents/trips/$(tripKey)).data.get('track', {}).get('personKey', '')
          == firestore.get(userPath()).data.get('personKey', '');
    }
    match /tenant/{tenantId}/tracks/{tripKey}/{file} {
      allow read, delete: if trackOwner(tripKey);
      allow create, update: if trackOwner(tripKey) && file.matches('[0-9]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 512 * 1024;
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
