# Store publishing for the tenant apps (spec 1.10 §8, skill `android-release`).
#
#   fastlane android internal app:scs-app            build, gate, sign, upload to Internal testing
#   fastlane android promote  app:scs-app to:alpha   promote the newest internal release
#   fastlane ios     beta     app:scs-app            build, gate, sign, upload to TestFlight
#
# Every lane takes `app:<app>`: paths, package name and secrets derive from it, so a second
# tenant is configuration, not new code. Secrets live outside the repo in ~/.okr-secrets/android/.

default_platform(:android)

ROOT = File.expand_path('..', __dir__)
SECRETS = File.expand_path('~/.okr-secrets/android')
PLAY_JSON_KEY = File.join(SECRETS, 'play-service-account.json')
IOS_SECRETS = File.expand_path('~/.okr-secrets/ios')
ASC_API_KEY = File.join(IOS_SECRETS, 'asc_api_key.json') # fastlane format: key_id, issuer_id, key (p8 content)
APPLE_TEAM_ID = '7X4J6XQJV3' # one Apple developer account ("Bruno Kaiser") for every tenant app
TRACKS = %w[production beta alpha internal].freeze

# Gradle 8.14.3 runs on Java <= 24 and Capacitor 8 compiles at Java 21 (skill android-release).
ENV['JAVA_HOME'] ||= '/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home'
ENV['ANDROID_HOME'] ||= File.expand_path('~/Library/Android/sdk')

platform :android do
  desc 'Build, gate, sign and upload a new versionCode to Internal testing'
  lane :internal do |options|
    app = app_param(options)
    package = package_name(app)
    version_code = next_version_code(package)
    UI.message("#{app} (#{package}) → versionCode #{version_code}")

    begin
      # --skip-nx-cache: environment.ts is generated and git-ignored, so it is NOT in the Nx cache
      # hash — a cached "production" build once shipped the DEV bundle (versionCode 1).
      sh_root("pnpm nx build #{app} --configuration production --skip-nx-cache")
      gate_production!(Dir[File.join(ROOT, "dist/apps/#{app}/browser/main-*.js")].max_by { |f| File.mtime(f) }, 'dist')
      sh_root("cd apps/#{app} && pnpm exec cap sync android")
      sh_root("cd apps/#{app}/android && ./gradlew bundleRelease -PversionCode=#{version_code} --console=plain -q")

      aab = File.join(ROOT, "apps/#{app}/android/app/build/outputs/bundle/release/app-release.aab")
      gate_production!(aab, 'aab')

      upload_to_play_store(
        package_name: package,
        json_key: PLAY_JSON_KEY,
        track: 'internal',
        aab: aab,
        release_status: 'completed',
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
      )
      UI.success("#{package} versionCode #{version_code} is on Internal testing")
    ensure
      # Give local `nx serve` its development environment back (production: false).
      sh_root("pnpm nx build #{app} --skip-nx-cache", log: false)
    end
  end

  desc 'Promote the newest Internal release to another track (to: alpha | beta | production)'
  lane :promote do |options|
    app = app_param(options)
    to = options[:to] || UI.user_error!('Missing to:<alpha|beta|production>')
    UI.user_error!("Unknown track #{to}") unless TRACKS.include?(to)
    upload_to_play_store(
      package_name: package_name(app),
      json_key: PLAY_JSON_KEY,
      track: 'internal',
      track_promote_to: to,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end

platform :ios do
  desc 'Build, gate, sign and upload a new build to TestFlight'
  lane :beta do |options|
    app = options[:app] || UI.user_error!('Missing app:<app>, e.g. app:scs-app')
    ios_dir = File.join(ROOT, "apps/#{app}/ios/App")
    UI.user_error!("No iOS project at #{ios_dir}") unless Dir.exist?(ios_dir)
    UI.user_error!("Missing #{ASC_API_KEY} (App Store Connect API key)") unless File.exist?(ASC_API_KEY)
    plist = File.join(ios_dir, 'App/GoogleService-Info.plist')
    UI.user_error!("Missing #{plist} — copy it from #{IOS_SECRETS}/#{app}/") unless File.exist?(plist)

    bundle_id = package_name(app)
    # CFBundleVersion = latest TestFlight build + 1 (spec 1.10 §7); none yet → 1.
    build_number = latest_testflight_build_number(app_identifier: bundle_id, api_key_path: ASC_API_KEY, initial_build_number: 0) + 1
    version = JSON.parse(File.read(File.join(ROOT, 'package.json')))['version']
    UI.message("#{app} (#{bundle_id}) → #{version} (#{build_number})")

    begin
      sh_root("pnpm nx build #{app} --configuration production --skip-nx-cache")
      gate_production!(Dir[File.join(ROOT, "dist/apps/#{app}/browser/main-*.js")].max_by { |f| File.mtime(f) }, 'dist')
      # Homebrew's fastlane wrapper exports its own GEM_HOME/GEM_PATH; CocoaPods (run by cap sync)
      # then resolves its gems there and dies with "Could not find 'drb'". Run it without them.
      sh_root("cd apps/#{app} && env -u GEM_HOME -u GEM_PATH pnpm exec cap sync ios")

      # App Store profile, created or renewed by the API key (App-Manager may do this) and installed
      # locally. Exporting with Xcode's automatic signing fails from the command line ("No Accounts"
      # — xcodebuild cannot use Xcode 27's Apple Accounts), so the export signs manually with it.
      get_provisioning_profile(app_identifier: bundle_id, api_key_path: ASC_API_KEY,
                               output_path: File.join(ROOT, "dist/ios/#{app}"))
      profile_name = lane_context[SharedValues::SIGH_NAME]

      ipa = build_app(
        workspace: File.join(ios_dir, 'App.xcworkspace'),
        scheme: 'App',
        configuration: 'Release',
        output_directory: File.join(ROOT, "dist/ios/#{app}"),
        output_name: 'App.ipa',
        clean: true,
        # Archive with the project's automatic (development) signing; the export re-signs for the
        # App Store with the "Apple Distribution" certificate from the local Keychain (spec §15.3,
        # created once in Xcode → Settings → Apple Accounts → Manage Certificates) and the profile.
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version}",
        export_options: {
          method: 'app-store-connect',
          signingStyle: 'manual',
          signingCertificate: 'Apple Distribution',
          teamID: APPLE_TEAM_ID,
          provisioningProfiles: { bundle_id => profile_name },
        },
      )
      gate_production!(ipa, 'ipa')

      upload_to_testflight(api_key_path: ASC_API_KEY, ipa: ipa, skip_waiting_for_build_processing: true)
      UI.success("#{bundle_id} #{version} (#{build_number}) is uploaded to TestFlight")
    ensure
      sh_root("pnpm nx build #{app} --skip-nx-cache", log: false)
    end
  end
end

# ── helpers ───────────────────────────────────────────────────────────────────

def app_param(options)
  app = options[:app] || UI.user_error!('Missing app:<app>, e.g. app:scs-app')
  UI.user_error!("No Android project at apps/#{app}/android") unless Dir.exist?(File.join(ROOT, "apps/#{app}/android"))
  UI.user_error!("Missing #{PLAY_JSON_KEY} (skill android-release, bootstrap step 7)") unless File.exist?(PLAY_JSON_KEY)
  app
end

# The package is `appId` in capacitor.config.ts — one source of truth for every platform.
def package_name(app)
  cfg = File.read(File.join(ROOT, "apps/#{app}/capacitor.config.ts"))
  cfg[/appId:\s*'([^']+)'/, 1] || UI.user_error!("No appId in apps/#{app}/capacitor.config.ts")
end

# versionCode = highest on ANY track + 1 (spec 1.10 §7). A track without releases raises; skip it.
def next_version_code(package)
  codes = TRACKS.flat_map do |track|
    google_play_track_version_codes(package_name: package, json_key: PLAY_JSON_KEY, track: track)
  rescue StandardError
    []
  end
  UI.user_error!("No versionCode found on any track for #{package} — the first upload is manual") if codes.empty?
  codes.max + 1
end

# Release gate: the bundled environment must be production (`production:!0` after minification).
def gate_production!(path, where)
  UI.user_error!("Gate (#{where}): nothing to check at #{path.inspect}") if path.nil? || !File.exist?(path)
  # The web bundle sits at base/assets/public/ in an AAB and at Payload/App.app/public/ in an IPA.
  archive_pattern = { '.aab' => 'assets/public/main-[^/]*\\.js$', '.ipa' => 'App\\.app/public/main-[^/]*\\.js$' }[File.extname(path)]
  js = if archive_pattern
         entry = sh("unzip -l #{path.shellescape} | awk '{print $4}' | grep -E '#{archive_pattern}'", log: false).strip
         sh("unzip -p #{path.shellescape} #{entry.shellescape}", log: false)
       else
         File.read(path)
       end
  flags = js.scan(/production:!([01])/).flatten.uniq
  UI.user_error!("Gate (#{where}): bundle is not production (found #{flags.inspect}) — refusing to ship") unless flags == ['0']
  UI.success("Gate (#{where}): production:!0")
end

def sh_root(cmd, log: true)
  sh("cd #{ROOT.shellescape} && #{cmd}", log: log)
end
